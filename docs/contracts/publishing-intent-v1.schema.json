{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "source",
    "components",
    "export_plan",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.publishing-intent/v1"
    },
    "request": {
      "$ref": "publishing-request-v1.schema.json"
    },
    "source": {
      "$ref": "final-video-handoff-v1.schema.json"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          }
        }
      }
    },
    "export_plan": {
      "anyOf": [
        {
          "$ref": "pipeline-v3-plan-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.publishing-intent/v1",
  "description": "PRIVATE immutable initial source/request/components and optional first native export plan. Later outputs and review bindings remain unknown until their actual accepted predecessors exist; Rust recomputes the entire current intent. Authored, uncompiled and unvalidated; shape alone supplies no current acceptance, approval or publication authority."
}
