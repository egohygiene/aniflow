        "start_microseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000000
        },
        "end_microseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000000
        },
        "pitch": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "activation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "nativeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sample_rate_hz",
        "channels",
        "sample_frames",
        "duration_microseconds",
        "notes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-midi-observation/v1"
        },
        "sample_rate_hz": {
          "const": 22050
        },
        "channels": {
          "const": 1
        },
        "sample_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2646000
        },
        "duration_microseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000000
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/nativeNote"
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "start_tick",
        "end_tick",
        "pitch",
        "velocity",
        "activation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^note_[0-9]{6}$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "start": {
          "$ref": "#/$defs/midiTime"
        },
        "end": {
          "$ref": "#/$defs/midiTime",
          "properties": {
            "numerator": {
              "minimum": 1
            }
          }
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 230400
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 230400
        },
        "pitch": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "activation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "notes"
      ],
      "properties": {
        "native": {
          "$ref": "#/$defs/nativeObservation"
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "python_version",
        "basic_pitch_version",
        "basic_pitch_revision",
        "onnxruntime_version",
        "numpy_version",
        "librosa_version",
        "scipy_version",
        "pretty_midi_version",
        "runtime_sha256",
        "runtime_file_count",
        "runtime_byte_count",
        "license"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-midi-probe/v1"
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(?:10|11)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "maxLength": 256
        },
        "basic_pitch_version": {
          "const": "0.4.0"
        },
        "basic_pitch_revision": {
          "const": "9991303bba609a3b93089d13ec80d1d495083596"
        },
        "onnxruntime_version": {
          "const": "1.20.1"
        },
        "numpy_version": {
          "const": "1.26.4"
        },
        "librosa_version": {
          "const": "0.10.2.post1"
        },
        "scipy_version": {
          "const": "1.13.1"
        },
        "pretty_midi_version": {
          "const": "0.2.10"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "runtime_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basic_pitch_expression",
            "basic_pitch_metadata_sha256",
            "onnxruntime_expression",
            "onnxruntime_metadata_sha256"
          ],
          "properties": {
            "basic_pitch_expression": {
              "const": "Apache-2.0"
            },
            "basic_pitch_metadata_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "onnxruntime_expression": {
              "const": "MIT"
            },
            "onnxruntime_metadata_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "rawObservationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "midi_observation"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observation"
          ],
          "properties": {
            "status": {
              "const": "candidate"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "unsupported_sample_rate",
                "unsupported_channels",
                "duration_limit",
                "silent_input"
              ]
            }
          }
        }
      ]
    },
    "runtimePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "file_count",
        "byte_count"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "uniqueItems": true
        },
        "stem_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "settingsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_sha256",
        "adapter_sha256",
        "runtime",
        "model",
        "tool_timeout_milliseconds",
        "maximum_tool_output_bytes"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(?:10|11)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "maxLength": 256
        },
        "python_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapter_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime": {
          "$ref": "#/$defs/runtimePin"
        },
        "model": {
          "$ref": "#/$defs/modelEvidence"
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2097152
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "byte_size"
          ],
          "properties": {
            "id": {
              "const": "source_audio"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 44,
              "maximum": 268435456
            }
          }
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        },
        "origin": {
          "$ref": "#/$defs/sourceOrigin"
        },
        "stem": {
          "anyOf": [
            {
              "$ref": "#/$defs/stemIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Bounded v1 profile: one zero-origin selected audio stream, index 0. Generalized container/stream mappings are deferred."
    },
    "sourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "const": 0
        },
        "denominator": {
          "const": 1
        }
      }
    },
    "stemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_mix",
        "relationship_evidence_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "original_mix": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "byte_size": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "relationship_evidence_id": {
          "$ref": "#/$defs/localId"
        }
      }
    }
  }
}
