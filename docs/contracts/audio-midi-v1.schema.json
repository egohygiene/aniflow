{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-midi/v1",
  "title": "audio MIDI candidate report v1",
  "description": "Closed bounded MIDI candidate contract. Rust additionally checks exact identities, canonical source timing, note order and overlap, source-relative bounds, deterministic note/tick derivation and MIDI bytes. Candidate activation is not calibrated confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "scope",
    "technical_artifact",
    "upstream_analysis_artifact",
    "raw_observation",
    "provider",
    "implementation_sha256",
    "configuration_sha256",
    "provider_lock_sha256",
    "settings",
    "probe",
    "commands",
    "method",
    "provenance",
    "confidence",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-midi/v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "technical_artifact": {
      "$ref": "#/$defs/evidenceReference",
      "properties": {
        "id": {
          "const": "technical"
        }
      }
    },
    "upstream_analysis_artifact": {
      "$ref": "#/$defs/evidenceReference",
      "properties": {
        "id": {
          "enum": [
            "analysis",
            "stem_analysis"
          ]
        }
      }
    },
    "raw_observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/rawObservationReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-midi"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "settings": {
      "$ref": "#/$defs/settingsEvidence"
    },
    "probe": {
      "$ref": "#/$defs/probe"
    },
    "commands": {
      "enum": [
        [
          {
            "tool": "python",
            "arguments": [
              "-I",
              "-B",
              "{staged_adapter}",
              "--probe"
            ]
          },
          {
            "tool": "python",
            "arguments": [
              "-I",
              "-B",
              "{staged_adapter}",
              "--input",
              "{snapshot}",
              "--model",
              "{staged_model}"
            ]
          },
          {
            "tool": "python",
            "arguments": [
              "-I",
              "-B",
              "{staged_adapter}",
              "--probe"
            ]
          }
        ],
        [
          {
            "tool": "python",
            "arguments": [
              "-I",
              "-B",
              "{staged_adapter}",
              "--probe"
            ]
          },
          {
            "tool": "python",
            "arguments": [
              "-I",
              "-B",
              "{staged_adapter}",
              "--probe"
            ]
          }
        ]
      ]
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "provenance": {
      "const": "probabilistic"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "const": "Note activations and MIDI velocities are not calibrated confidence; inferred notes are unreviewed candidates."
        }
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "raw_observation": {
            "$ref": "#/$defs/rawObservationReference"
          },
          "commands": {
            "const": [
              {
                "tool": "python",
                "arguments": [
                  "-I",
                  "-B",
                  "{staged_adapter}",
                  "--probe"
                ]
              },
              {
                "tool": "python",
                "arguments": [
                  "-I",
                  "-B",
                  "{staged_adapter}",
                  "--input",
                  "{snapshot}",
                  "--model",
                  "{staged_model}"
                ]
              },
              {
                "tool": "python",
                "arguments": [
                  "-I",
                  "-B",
                  "{staged_adapter}",
                  "--probe"
                ]
              }
            ]
          },
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 22050
              },
              "channels": {
                "const": 1
              },
              "frame_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2646000
              },
              "artifact": {
                "properties": {
                  "byte_size": {
                    "maximum": 8388608
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "raw_observation": {
            "const": null
          },
          "commands": {
            "const": [
              {
                "tool": "python",
                "arguments": [
                  "-I",
                  "-B",
                  "{staged_adapter}",
                  "--probe"
                ]
              },
              {
                "tool": "python",
                "arguments": [
                  "-I",
                  "-B",
                  "{staged_adapter}",
                  "--probe"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "unsupported_sample_rate"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "not": {
                  "const": 22050
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "unsupported_channels"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 22050
              },
              "channels": {
                "const": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "duration_limit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 22050
              },
              "channels": {
                "const": 1
              },
              "frame_count": {
                "minimum": 2646001
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "silent_input"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 22050
              },
              "channels": {
                "const": 1
              },
              "frame_count": {
                "maximum": 2646000
              }
            }
          }
        }
      }
    }
