{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.frame-import-report/v1",
  "title": "aniflow observed frame import v1",
  "description": "Contemporary import observations over the exact declared frame index. Source and file identity, complete membership, bounded PNG structure and one RGB24 decoded packet per frame are checked by Rust/native provider execution. The report does not establish that these PNGs were extracted from the supplied video, historical processing, visual fidelity or native qualification. Deserialization and schema validation are not runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "stage_id", "provider_lock_sha256", "configuration_sha256",
    "source_sha256", "source_byte_count", "frame_index_sha256", "index",
    "historical_processing", "source_relationship", "decode_method", "decoder", "frames"
  ],
  "properties": {
    "schema": { "const": "aniflow.frame-import-report/v1" },
    "stage_id": { "type": "string", "minLength": 1 },
    "provider_lock_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_byte_count": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "frame_index_sha256": { "$ref": "#/$defs/sha256" },
    "index": { "$ref": "rife-frame-index-v1.schema.json" },
    "historical_processing": { "const": "unknown" },
    "source_relationship": { "const": "declared_not_verified" },
    "decode_method": { "const": "ffmpeg_png_rgb24_framehash_sha256" },
    "decoder": { "$ref": "#/$defs/decoder" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "not": { "pattern": "[\\x00-\\x1f\\x7f-\\x9f]" } },
    "decoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "const": "ffmpeg" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "filename", "sha256", "byte_count", "decoded_rgb24_sha256", "decoded_byte_count"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 99999 },
        "filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.png$",
          "not": { "pattern": "[\\x00-\\x1f\\x7f-\\x9f]" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "decoded_rgb24_sha256": { "$ref": "#/$defs/sha256" },
        "decoded_byte_count": { "type": "integer", "minimum": 3, "maximum": 25200000, "multipleOf": 3 }
      }
    }
  }
}
