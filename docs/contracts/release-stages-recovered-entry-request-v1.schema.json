{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.release-stages-recovered-entry-request/v1",
  "$comment": "Authored/unvalidated; recovered/native/final-video owners retain all authority. Read-only projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recipe_kind",
    "recipe_run_directory",
    "expected_recipe_intent_sha256",
    "artifact_id"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.release-stages-recovered-entry-request/v1"
    },
    "recipe_kind": {
      "enum": [
        "recovered_v1",
        "recovered_with_rife_v2"
      ]
    },
    "recipe_run_directory": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1,
      "maxLength": 4096
    },
    "expected_recipe_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "release_request": {
      "anyOf": [
        {
          "$ref": "release-stages-request-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
