{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.upscayl-chunk-recovery-report/v1",
  "title": "aniflow collected Upscayl chunk recovery observations v1",
  "description": "Complete observations from the same run's accepted chunk dependencies. Rust checks contiguous partition, complete ordinal/name/timing mapping, exact operation identity and output digests. The original source index is retained verbatim. Chunk-level process duration is not falsely attributed to individual frames. Schema validity is not historical import, independent per-frame acceptance or native/visual qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage_id",
    "provider_lock_sha256",
    "configuration_sha256",
    "source_relationship",
    "historical_processing",
    "backend_qualification",
    "output_index",
    "chunks"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.upscayl-chunk-recovery-report/v1"
    },
    "stage_id": {
      "const": "collect_upscaled_chunks"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_relationship": {
      "const": "declared_not_verified"
    },
    "historical_processing": {
      "const": "unknown"
    },
    "backend_qualification": {
      "const": "unqualified"
    },
    "output_index": {
      "$ref": "upscayl-output-index-v1.schema.json"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "upscayl-chunk-report-v1.schema.json"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  }
}
