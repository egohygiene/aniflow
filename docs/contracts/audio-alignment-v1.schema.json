{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-alignment/v1",
  "title": "reviewed-lyrics alignment candidate evidence v1",
  "description": "Closed bounded alignment profile. Rust additionally validates UTF-8 byte limits, resource total size, source/review identity, reduced times, exact token offsets, order, conservative matching and derived candidate equality. Review attestations remain caller claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "scope",
    "technical_artifact",
    "upstream_analysis_artifact",
    "reviewed_lyrics",
    "provider",
    "implementation_sha256",
    "configuration_sha256",
    "provider_lock_sha256",
    "settings",
    "licenses",
    "commands",
    "method",
    "provenance",
    "confidence",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-alignment/v1"
    },
    "source": {
      "$ref": "#/$defs/alignmentSource"
    },
    "scope": {
      "$ref": "#/$defs/alignmentScope"
    },
    "technical_artifact": {
      "$ref": "#/$defs/evidenceReference",
      "properties": {
        "id": {
          "const": "technical"
        }
      }
    },
    "upstream_analysis_artifact": {
      "$ref": "#/$defs/evidenceReference",
      "properties": {
        "id": {
          "enum": [
            "analysis",
            "stem_analysis"
          ]
        }
      }
    },
    "reviewed_lyrics": {
      "$ref": "#/$defs/reviewedLyrics"
    },
    "raw_observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/rawObservationReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-alignment"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "settings": {
      "$ref": "#/$defs/settingsEvidence"
    },
    "licenses": {
      "const": {
        "tool_expression": "BSD-2-Clause; bundled components retain their own notices",
        "tool_source_url": "https://github.com/cmusphinx/pocketsphinx/blob/511126b492dcb267cf30d49d631946d7b61a9530/LICENSE",
        "model_expression": "BSD-2-Clause (Alpha Cephei declaration)",
        "model_source_url": "https://github.com/cmusphinx/pocketsphinx/blob/511126b492dcb267cf30d49d631946d7b61a9530/model/en-us/en-us/README",
        "dictionary_statement": "CMU dictionary attribution and upstream terms are recorded, not independently verified.",
        "dictionary_source_url": "https://github.com/cmusphinx/pocketsphinx/blob/511126b492dcb267cf30d49d631946d7b61a9530/model/en-us/cmudict-en-us.dict"
      }
    },
    "commands": {
      "enum": [
        [],
        [
          {
            "tool": "pocketsphinx",
            "arguments": [
              "-hmm",
              "{staged_model}",
              "-dict",
              "{staged_dictionary}",
              "-lm",
              "{staged_disabled_lm}",
              "-samprate",
              "16000",
              "-frate",
              "100",
              "-phone_align",
              "no",
              "-state_align",
              "no",
              "-fsgusealtpron",
              "no",
              "-loglevel",
              "ERROR",
              "align",
              "{snapshot}",
              "{reviewed_phrase}"
            ]
          }
        ]
      ]
    },
    "method": {
      "const": {
        "sample_rate_hz": 16000,
        "downmix": "none",
        "timestamp_grid_milliseconds": 10,
        "tokenization": "ascii-english-byte-offsets/v1",
        "alternate_pronunciations": false,
        "gpu": false,
        "review_attestation_independently_verified": false,
        "timing_reviewed": false
      }
    },
    "provenance": {
      "const": "probabilistic"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "const": "Forced alignment scores are not calibrated confidence and do not establish that the supplied words occur in the audio."
        }
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "timed_text": {
      "anyOf": [
        {
          "$ref": "#/$defs/alignedDocument"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "raw_observation",
          "timed_text"
        ],
        "properties": {
          "raw_observation": {
            "$ref": "#/$defs/rawObservationReference"
          },
          "timed_text": {
            "$ref": "#/$defs/alignedDocument"
          },
          "commands": {
            "const": [
              {
                "tool": "pocketsphinx",
                "arguments": [
                  "-hmm",
                  "{staged_model}",
                  "-dict",
                  "{staged_dictionary}",
                  "-lm",
                  "{staged_disabled_lm}",
                  "-samprate",
                  "16000",
                  "-frate",
                  "100",
                  "-phone_align",
                  "no",
                  "-state_align",
                  "no",
                  "-fsgusealtpron",
                  "no",
                  "-loglevel",
                  "ERROR",
                  "align",
                  "{snapshot}",
                  "{reviewed_phrase}"
                ]
              }
            ]
          },
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 16000
              },
              "channels": {
                "const": 1
              },
              "frame_count": {
                "maximum": 9600000
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "raw_observation": {
            "type": "null"
          },
          "timed_text": {
            "type": "null"
          },
          "commands": {
            "const": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "unsupported_sample_rate"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "not": {
                  "const": 16000
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "unsupported_channels"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 16000
              },
              "channels": {
                "const": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "const": "silent_input"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sample_rate_hz": {
                "const": 16000
              },
              "channels": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "alignedCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "timing"
      ],
      "properties": {
        "cue_id": {
          "$ref": "#/$defs/tt_cueId"
        },
        "timing": {
          "$ref": "#/$defs/cueTiming"
        }
      }
    },
    "alignedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "provenance",
        "overlap_policy",
        "metadata",
        "cues",
        "language",
        "audio_source"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.timed-text/v1"
        },
        "source": {
          "$ref": "#/$defs/tt_sourceText"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "authority",
            "evidence",
            "source_sha256"
          ],
          "properties": {
            "kind": {
              "const": "reviewed_lyrics"
            },
            "authority": {
              "$ref": "#/$defs/tt_reviewAuthority"
            },
            "evidence": {
              "$ref": "#/$defs/tt_reviewEvidence"
            },
            "source_sha256": {
              "$ref": "#/$defs/tt_sha256"
            }
          }
        },
        "language": {
          "const": "en"
        },
        "audio_source": {
          "$ref": "#/$defs/alignmentSource"
        },
        "overlap_policy": {
          "enum": [
            "reject",
            "allow"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/tt_metadata",
          "required": [
            "aniflow_alignment_timing"
          ],
          "properties": {
            "aniflow_alignment_timing": {
              "const": "candidate"
            }
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/reviewedCue"
          }
        }
      }
    },
    "alignedWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "timing"
      ],
      "properties": {
        "token": {
          "$ref": "#/$defs/token"
        },
        "timing": {
          "$ref": "#/$defs/wordTiming"
        }
      }
    },
    "alignmentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "uniqueItems": true
        },
        "stem_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "alignmentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "byte_size"
          ],
          "properties": {
            "id": {
              "const": "source_audio"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 44,
              "maximum": 268435456
            }
          }
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        },
        "origin": {
          "$ref": "#/$defs/sourceOrigin"
        },
        "stem": {
          "anyOf": [
            {
              "$ref": "#/$defs/stemIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Bounded v1 profile: one zero-origin selected audio stream, index 0. Generalized container/stream mappings are deferred."
    },
    "alignmentTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "denominator": {
          "enum": [
            1,
            2,
            4,
            5,
            10,
            20,
            25,
            50,
            100
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 600
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 1200
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 2400
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 3000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 10
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 6000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 20
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 12000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 25
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 15000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 50
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 30000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 100
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 60000
              }
            }
          }
        }
      ]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "$ref": "#/$defs/safeInteger"
        }
      }
    },
    "cueTiming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "start",
            "end"
          ],
          "properties": {
            "status": {
              "const": "candidate"
            },
            "start": {
              "$ref": "#/$defs/alignmentTime"
            },
            "end": {
              "$ref": "#/$defs/alignmentTime"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "partial"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unmatched"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "ambiguous"
            }
          }
        }
      ]
    },
    "dictionaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "files"
      ],
      "properties": {
        "model_id": {
          "const": "en-us"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "feat.params"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "mdef"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "means"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "noisedict"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "sendump"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "transition_matrices"
                }
              }
            },
            {
              "$ref": "#/$defs/modelFile",
              "properties": {
                "name": {
                  "const": "variances"
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "modelFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "name": {
          "enum": [
            "feat.params",
            "mdef",
            "means",
            "noisedict",
            "sendump",
            "transition_matrices",
            "variances"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "nativeWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[a-z]+(?:'[a-z]+)*(?![\\s\\S])"
        },
        "start": {
          "$ref": "#/$defs/alignmentTime"
        },
        "end": {
          "$ref": "#/$defs/alignmentTime"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_words",
        "words",
        "cues"
      ],
      "properties": {
        "native_words": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/nativeWord"
          }
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/alignedWord"
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/alignedCue"
          }
        }
      }
    },
    "rawObservationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "alignment_observation"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observation"
          ],
          "properties": {
            "status": {
              "const": "candidate"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "unsupported_sample_rate",
                "unsupported_channels",
                "silent_input"
              ]
            }
          }
        }
      ]
    },
    "reviewedCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
