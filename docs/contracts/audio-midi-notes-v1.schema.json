    "nativeNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_microseconds",
        "end_microseconds",
        "pitch",
        "velocity",
        "activation"
      ],
      "properties": {
        "start_microseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000000
        },
        "end_microseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000000
        },
        "pitch": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "activation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "nativeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sample_rate_hz",
        "channels",
        "sample_frames",
        "duration_microseconds",
        "notes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-midi-observation/v1"
        },
        "sample_rate_hz": {
          "const": 22050
        },
        "channels": {
          "const": 1
        },
        "sample_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2646000
        },
        "duration_microseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000000
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/nativeNote"
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "start_tick",
        "end_tick",
        "pitch",
        "velocity",
        "activation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^note_[0-9]{6}$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "start": {
          "$ref": "#/$defs/midiTime"
        },
        "end": {
          "$ref": "#/$defs/midiTime",
          "properties": {
            "numerator": {
              "minimum": 1
            }
          }
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 230400
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 230400
        },
        "pitch": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
