{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.spatial-rife-configuration/v1",
  "$comment": "Authored/unvalidated. Rust rechecks exact current native Upscayl and RIFE acceptance, original inspection and separate processing geometry/derived clocks. No quality approval or native qualification inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "configuration",
    "spatial"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.spatial-rife-configuration/v1"
    },
    "configuration": {
      "$ref": "../../providers/rife/configuration.schema.json"
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_directory",
        "manifest_sha256",
        "index_sha256"
      ],
      "properties": {
        "run_directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
