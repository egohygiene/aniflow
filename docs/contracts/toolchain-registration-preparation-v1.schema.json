{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-registration-preparation-v1.schema.json",
  "title": "aniflow inert toolchain registration preparation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aniflow.toolchain.registration-preparation/v1"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ready": {
      "type": "boolean"
    },
    "native_qualification": {
      "const": false
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "inspection": {
      "$ref": "#/$defs/inspection"
    },
    "files": {
      "type": "array",
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/configuration_file"
        },
        {
          "$ref": "#/$defs/manifest_file"
        },
        {
          "$ref": "#/$defs/preflight_file"
        },
        {
          "$ref": "#/$defs/registration_file"
        }
      ],
      "items": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "request_sha256",
    "ready",
    "native_qualification",
    "inspection",
    "files",
    "diagnostics"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        },
        "required": [
          "ready"
        ]
      },
      "then": {
        "required": [
          "adapter"
        ],
        "properties": {
          "adapter": {
            "$ref": "#/$defs/adapter"
          },
          "files": {
            "minItems": 4
          },
          "inspection": {
            "properties": {
              "ready": {
                "const": true
              }
            }
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "executable_sha256"
      ]
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "inspection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inspection_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "inspection_platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "inspection_fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/inspection_id"
        },
        "dependency_id": {
          "$ref": "#/$defs/inspection_id"
        },
        "check": {
          "$ref": "#/$defs/inspection_text"
        },
        "status": {
          "enum": [
            "installed",
            "missing",
            "incompatible",
            "unverified"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "capability_id",
        "check",
        "status",
        "detail"
      ]
    },
    "inspection_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/inspection_id"
        },
        "dependency_id": {
          "$ref": "#/$defs/inspection_id"
        },
        "kind": {
          "$ref": "#/$defs/inspection_text"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "suggested_locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "required": [
        "capability_id",
        "kind",
        "detail",
        "suggested_locators"
      ]
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aniflow.toolchain-report/v1"
        },
        "profile_id": {
          "$ref": "#/$defs/inspection_id"
        },
        "profile_sha256": {
          "$ref": "#/$defs/inspection_sha256"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/inspection_sha256"
        },
        "selected_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspection_id"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64
        },
        "ready": {
          "type": "boolean"
        },
        "native_qualification": {
          "const": false
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspection_fact"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspection_action"
          }
        }
      },
      "required": [
        "schema",
        "profile_id",
        "profile_sha256",
        "inventory_sha256",
        "selected_capabilities",
        "ready",
        "native_qualification",
        "facts",
        "actions"
      ]
    },
    "preflight_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_profile_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "preflight_profile_dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "kind": {
          "enum": [
            "tool",
            "model"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "version_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "package_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/preflight_profile_sha256"
        },
        "required_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "required_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "native_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "suggested_locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/?#\\s\\u0000-\\u001f\\u007f-\\u009f]+(?:[^\\s\\u0000-\\u001f\\u007f-\\u009f]*)$",
            "maxLength": 2048
          },
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "kind",
        "optional",
        "required_flags",
        "required_features",
        "suggested_locators"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "native_scale"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "version_requirement"
              ]
            },
            "properties": {
              "required_flags": {
                "maxItems": 0
              },
              "required_features": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "preflight_profile_backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "required_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "name",
        "required_features"
      ]
    },
    "preflight_profile_scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "requested": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "mode": {
          "enum": [
            "native",
            "post_resize"
          ]
        }
      },
      "required": [
        "native",
        "requested",
        "mode"
      ]
    },
    "preflight_profile_capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "optional": {
          "type": "boolean"
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_id"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 128
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_platform"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 32
        },
        "backend": {
          "$ref": "#/$defs/preflight_profile_backend"
        },
        "scale": {
          "$ref": "#/$defs/preflight_profile_scale"
        },
        "effective_settings": {
          "type": "object"
        },
        "side_effects": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem_read",
              "filesystem_write",
              "environment_read",
              "subprocess",
              "network",
              "ai",
              "gpu",
              "publish"
            ]
          },
          "uniqueItems": true,
          "maxItems": 8
        }
      },
      "required": [
        "id",
        "optional",
        "dependency_ids",
        "platforms",
        "effective_settings",
        "side_effects"
      ]
    },
    "preflight_inventory_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_inventory_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_inventory_platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "preflight_inventory_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable_sha256": {
          "$ref": "#/$defs/preflight_inventory_sha256"
        },
        "version": {
          "$ref": "#/$defs/preflight_inventory_text"
        },
        "package_revision": {
          "$ref": "#/$defs/preflight_inventory_text"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "native_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "executable_sha256",
        "flags",
        "features",
        "provenance"
      ]
    },
    "preflight_inventory_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "$ref": "#/$defs/preflight_inventory_id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
        },
        "expected_sha256": {
          "$ref": "#/$defs/preflight_inventory_sha256"
        },
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824,
          "default": 536870912
        },
        "observation": {
          "$ref": "#/$defs/preflight_inventory_observation"
        }
      },
      "required": [
        "dependency_id",
        "path",
        "expected_sha256"
      ]
    },
    "preflight_inventory_hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/preflight_inventory_id"
        },
        "available": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "name",
        "available",
        "features",
        "provenance"
      ]
    },
    "preflight_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "registration_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_id"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "ffmpeg_dependency_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "ffprobe_dependency_id": {
          "$ref": "#/$defs/preflight_id"
        }
      },
      "required": [
        "stage_id",
        "registration_id",
        "capability_ids",
        "ffmpeg_dependency_id",
        "ffprobe_dependency_id"
      ]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aniflow.toolchain.preflight/v1"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "aniflow.toolchain-profile/v1"
            },
            "id": {
              "$ref": "#/$defs/preflight_profile_id"
            },
            "default_capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_id"
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 64
            },
            "dependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_dependency"
              },
              "minItems": 1,
              "maxItems": 128
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_capability"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "schema",
            "id",
            "default_capabilities",
            "dependencies",
            "capabilities"
          ]
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "aniflow.toolchain-inventory/v1"
            },
            "platform": {
              "$ref": "#/$defs/preflight_inventory_platform"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_inventory_artifact"
              },
              "maxItems": 128
            },
            "hardware": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_inventory_hardware"
              },
              "maxItems": 32
            }
          },
          "required": [
            "schema",
            "platform",
            "artifacts",
            "hardware"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_binding"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "schema",
        "profile",
        "inventory",
        "bindings"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "manifest_providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "display_name"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-inspection"
        },
        "version": {
          "const": "2.0.0"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest_configurationSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*/v[1-9][0-9]*$"
        },
        "version": {
          "$ref": "#/$defs/manifest_semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/manifest_sha256"
        }
      }
    },
    "manifest_artifactPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact_type",
        "artifact_role",
        "cardinality",
        "immutable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "artifact_type": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "artifact_role": {
          "enum": [
            "temporal_source",
            "temporal_component",
            "intermediate",
            "candidate_master",
            "validated_master",
            "validation_evidence",
            "run_evidence",
            "delivery_receipt"
          ]
        },
        "stream_role": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "transcript",
            "timed_metadata",
            "attachment"
          ]
        },
        "cardinality": {
          "enum": [
            "one",
            "optional",
