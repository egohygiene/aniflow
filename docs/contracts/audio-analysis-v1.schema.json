{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/audio-analysis-v1.schema.json",
  "title": "aniflow normalized audio analysis v1",
  "description": "Structural evidence contract only. The public Rust validator additionally checks cross-reference identity, status consistency, source-relative range/order/overlap and kind-specific units. Neither validation path reads media or grants lyric authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source",
    "artifacts",
    "providers",
    "capabilities",
    "observations",
    "timelines",
    "semantic_artifacts",
    "excerpts",
    "diagnostics",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-analysis/v1"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerEvidence"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityOutcome"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "timelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeline"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "semantic_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticArtifact"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "excerpts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "printableText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*[^\\s])[^\\x00-\\x1f\\x7f-\\x9f]+$",
      "maxLength": 4096,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capabilityId": {
      "enum": [
        "aniflow/audio-technical-inspection",
        "aniflow/audio-signal-measurements",
        "aniflow/audio-stem-lineage",
        "aniflow/audio-musical-structure",
        "aniflow/audio-timed-text",
        "aniflow/audio-transcription",
        "aniflow/audio-lyrics-alignment",
        "aniflow/audio-midi-extraction"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "unsupported",
        "cancelled",
        "failed"
      ]
    },
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "$ref": "#/$defs/safeInteger"
        }
      }
    },
    "sourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "const": 0
        },
        "denominator": {
          "const": 1
        }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/safeInteger"
        },
        "end": {
          "$ref": "#/$defs/positiveSafeInteger"
        }
      },
      "description": "Half-open source sample-frame range [start,end). The Rust validator enforces start < end <= source.frame_count."
    },
    "stemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_mix",
        "relationship_evidence_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "original_mix": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "byte_size": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "relationship_evidence_id": {
          "$ref": "#/$defs/localId"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "byte_size": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 768000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "frame_count": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "origin": {
          "$ref": "#/$defs/sourceOrigin"
        },
        "stem": {
          "anyOf": [
            {
              "$ref": "#/$defs/stemIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Bounded v1 profile: one zero-origin selected audio stream, index 0. Generalized container/stream mappings are deferred."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "stem_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "licenseEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "statement",
            "evidence_artifact_id"
          ],
          "properties": {
            "kind": {
              "const": "recorded"
            },
            "statement": {
              "$ref": "#/$defs/printableText"
            },
            "evidence_artifact_id": {
              "$ref": "#/$defs/localId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/printableText"
            }
          }
        }
      ]
    },
    "componentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "revision",
        "sha256",
        "license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "version": {
          "$ref": "#/$defs/printableText"
        },
        "revision": {
          "$ref": "#/$defs/printableText"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license": {
          "$ref": "#/$defs/licenseEvidence"
        }
      }
    },
    "modelEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none_required"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "components"
          ],
          "properties": {
            "kind": {
              "const": "available"
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/componentEvidence"
              },
              "minItems": 1,
              "maxItems": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/printableText"
            }
          }
        }
      ]
    },
    "providerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "implementation_sha256",
        "configuration_sha256",
        "tools",
        "models",
        "license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "provider": {
          "$ref": "#/$defs/providerReference"
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentEvidence"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "models": {
          "$ref": "#/$defs/modelEvidence"
        },
        "license": {
          "$ref": "#/$defs/licenseEvidence"
        }
      }
    },
    "confidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "score"
          ],
          "properties": {
            "kind": {
              "const": "calibrated"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "score"
          ],
          "properties": {
            "kind": {
              "const": "uncalibrated"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/printableText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "confidence",
        "provider_evidence_id",
        "evidence_artifact_ids"
      ],
      "properties": {
        "class": {
          "enum": [
            "deterministic",
            "heuristic",
            "probabilistic"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "provider_evidence_id": {
          "$ref": "#/$defs/localId"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "properties": {
                  "kind": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "const": "deterministic"
              }
            }
          }
        }
      ]
    },
    "observationValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "properties": {
            "kind": {
              "const": "quantity"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "hertz",
                "channels",
                "beats_per_minute"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "properties": {
            "kind": {
              "const": "count"
            },
            "value": {
              "$ref": "#/$defs/safeInteger"
            },
            "unit": {
              "enum": [
                "hertz",
                "channels",
                "beats_per_minute"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "label"
            },
            "value": {
              "$ref": "#/$defs/printableText"
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_id",
        "kind",
        "value",
        "scope",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "kind": {
          "enum": [
            "sample_rate",
            "channel_count",
            "tempo",
            "key"
          ]
        },
        "value": {
          "$ref": "#/$defs/observationValue"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sample_rate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value",
                  "unit"
                ],
                "properties": {
                  "kind": {
                    "const": "quantity"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 768000
                  },
                  "unit": {
                    "const": "hertz"
                  }
                }
              },
              "capability_id": {
                "const": "aniflow/audio-technical-inspection"
              },
              "provenance": {
                "properties": {
                  "class": {
                    "enum": [
                      "deterministic"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "channel_count"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value",
                  "unit"
                ],
                "properties": {
                  "kind": {
                    "const": "count"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "unit": {
                    "const": "channels"
                  }
                }
              },
              "capability_id": {
                "const": "aniflow/audio-technical-inspection"
              },
              "provenance": {
                "properties": {
                  "class": {
                    "enum": [
                      "deterministic"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tempo"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value",
                  "unit"
                ],
                "properties": {
                  "kind": {
                    "const": "quantity"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  "unit": {
                    "const": "beats_per_minute"
                  }
                }
              },
              "capability_id": {
                "const": "aniflow/audio-musical-structure"
              },
              "provenance": {
                "properties": {
                  "class": {
                    "enum": [
                      "heuristic",
                      "probabilistic"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "key"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "label"
                  },
                  "value": {
                    "$ref": "#/$defs/printableText"
                  }
                }
              },
              "capability_id": {
                "const": "aniflow/audio-musical-structure"
              },
              "provenance": {
                "properties": {
                  "class": {
                    "enum": [
                      "heuristic",
                      "probabilistic"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "range",
        "label",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "range": {
          "$ref": "#/$defs/frameRange"
        },
        "label": {
          "$ref": "#/$defs/printableText"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_id",
        "kind",
        "scope",
        "events"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "kind": {
          "enum": [
            "markers",
            "disjoint_regions",
            "overlapping_regions"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "reviewedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied_by",
        "provenance_artifact_id"
      ],
      "properties": {
        "supplied_by": {
          "$ref": "#/$defs/printableText"
        },
        "provenance_artifact_id": {
          "$ref": "#/$defs/localId"
        }
      }
    },
    "semanticArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "capability_id",
        "kind",
        "provenance"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/localId"
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "kind": {
          "enum": [
            "observed_transcript",
            "reviewed_lyrics",
            "candidate_midi"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/reviewedAuthority"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reviewed_lyrics"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "authority"
            ],
            "properties": {
              "authority": {
                "$ref": "#/$defs/reviewedAuthority"
              }
            }
