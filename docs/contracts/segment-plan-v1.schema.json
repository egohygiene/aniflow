{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/segment-plan-v1.schema.json",
  "title": "aniflow segment plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capability_id", "source", "source_sha256", "source_size_bytes", "source_media", "output_directory", "segment_duration_ms", "expected_segments", "segments", "mode", "boundary_accuracy", "stream_policy", "estimated_required_bytes"],
  "properties": {
    "schema": { "const": "aniflow.segment-plan/v1" },
    "capability_id": { "const": "media.video.segment/v1" },
    "source": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_size_bytes": { "type": "integer", "minimum": 1 },
    "source_media": { "type": "object" },
    "output_directory": { "type": "string" },
    "segment_duration_ms": { "type": "integer", "minimum": 1, "maximum": 29999 },
    "expected_segments": { "type": "integer", "minimum": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "start_ms", "end_ms"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "mode": { "enum": ["stream_copy", "transcode_h264_aac"] },
    "boundary_accuracy": { "enum": ["keyframe_aligned", "frame_accurate"] },
    "stream_policy": { "type": "string", "minLength": 1 },
    "estimated_required_bytes": { "type": "integer", "minimum": 1 }
  }
}
