{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "source",
    "components",
    "export_plan",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-publishing-intent/v2"
    },
    "request": {
      "$ref": "audio-publishing-request-v2.schema.json"
    },
    "source": {
      "$ref": "final-lossless-audio-qc-intent-v1.schema.json#/properties/source"
    },
    "components": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          }
        }
      }
    },
    "export_plan": {
      "anyOf": [
        {
          "$ref": "pipeline-v3-plan-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-publishing-intent/v2",
  "description": "Explicit audio publishing v2 selects recognized resumable final-QC v2 and native 44.1/48 kHz views. Exact source/native plans, supplied review and manual package boundaries remain separate. Legacy partial roots are not upgraded. Authored, unvalidated and runtime unqualified; shape supplies no acceptance or publication authority."
}
