{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"aniflow.release-subjects/v1",
  "description":"PRIVATE immutable canonical subject file, at most 2 MiB. The raw SHA-256 covers these exact bytes; no self digest, later proof or verification event is included. Origin snapshots are retained historical evidence, not fresh archival acceptance.",
  "type":"object","additionalProperties":false,"required":["schema","release_id","version","request_sha256","subjects","creative_approval","ownership","publication_authority"],
  "properties":{
    "schema":{"const":"aniflow.release-subjects/v1"},"release_id":{"$ref":"release-evidence-request-v1.schema.json#/$defs/id"},"version":{"$ref":"release-evidence-request-v1.schema.json#/$defs/id"},"request_sha256":{"$ref":"release-evidence-request-v1.schema.json#/$defs/sha256"},
    "subjects":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/record"}},"creative_approval":{"const":"not_performed"},"ownership":{"const":"not_established"},"publication_authority":{"const":"none"}
  },
  "$defs":{
    "record":{"type":"object","additionalProperties":false,"required":["id","role","visibility","parents","path","sha256","byte_count","origin"],"properties":{
      "id":{"$ref":"release-evidence-request-v1.schema.json#/$defs/id"},"role":{"$ref":"release-evidence-request-v1.schema.json#/$defs/role"},"visibility":{"enum":["public","private"]},"parents":{"$ref":"release-evidence-request-v1.schema.json#/$defs/parents"},
      "path":{"type":"string","pattern":"^subjects/[0-9]{4}-[A-Za-z0-9][A-Za-z0-9_.-]{0,63}\\.bin$"},"sha256":{"$ref":"release-evidence-request-v1.schema.json#/$defs/sha256"},"byte_count":{"type":"integer","minimum":0,"maximum":1099511627776},"origin":{"$ref":"#/$defs/origin"}
    }},
    "origin":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","observation"],"properties":{"kind":{"const":"accepted_media"},"observation":{"$ref":"destination-preflight-v1.schema.json#/$defs/media"}}},
      {"type":"object","additionalProperties":false,"required":["kind","directory","member","receipt","receipt_sha256"],"properties":{"kind":{"const":"posting_member"},"directory":{"type":"string","minLength":1},"member":{"$ref":"release-evidence-request-v1.schema.json#/$defs/member"},"receipt":{"$ref":"posting-receipt-v1.schema.json"},"receipt_sha256":{"$ref":"release-evidence-request-v1.schema.json#/$defs/sha256"}}},
      {"type":"object","additionalProperties":false,"required":["kind","locator","declared_origin","technical_acceptance"],"properties":{"kind":{"const":"declared_file"},"locator":{"type":"string","minLength":1},"declared_origin":{"type":"string","minLength":1,"maxLength":2048},"technical_acceptance":{"const":"not_established; history is operator_declared"}}}
    ]}
  }
}
