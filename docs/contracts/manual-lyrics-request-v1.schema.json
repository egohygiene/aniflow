{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/egohygiene/aniflow/docs/contracts/manual-lyrics-request-v1.schema.json",
  "title":"aniflow explicit manual timed-lyrics request v1",
  "type":"object","additionalProperties":false,
  "required":["schema","audio_file","audio","timeline_sha256","recipe_intent_sha256","offset","delivery_extent","input_format","language","overlap_policy","targets","conversion"],
  "properties": {
    "schema":{"const":"aniflow.manual-lyrics-request/v1"},
    "audio_file":{"type":"string","minLength":1,"description":"Existing canonical original PCM input; exact hash and WAV facts are rechecked."},
    "audio":{"$ref":"audio-analysis-v1.schema.json#/$defs/source"},
    "timeline_sha256":{"$ref":"manual-checkpoint-v1.schema.json#/$defs/sha256"},
    "recipe_intent_sha256":{"$ref":"manual-checkpoint-v1.schema.json#/$defs/sha256"},
    "offset":{"$ref":"temporal-inspection-v1.schema.json#/$defs/rational","description":"Signed exact-millisecond presentation shift; no audio edit or inferred offset."},
    "delivery_extent":{"$ref":"temporal-inspection-v1.schema.json#/$defs/range"},
    "input_format":{"enum":["srt","webvtt","ttml"]},
    "language":{"type":["string","null"]},"overlap_policy":{"enum":["reject","allow"]},
    "targets":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"enum":["plain","lrc","srt","webvtt","ttml","json"]}},
    "conversion":{"type":"object","additionalProperties":false,"properties":{"allow_losses":{"type":"array","uniqueItems":true,"items":{"$ref":"timed-text-conversion-v1.schema.json#/$defs/lossKind"}}}}
  },
  "$comment":"Authored/unvalidated. Rust adds exact source/native-WAV, interval, byte/grid, extent, context/review and no-overwrite checks. External timeline/recipe IDs are caller bindings, not compressed-video correspondence proof. No model or automatic recognition path."
}
