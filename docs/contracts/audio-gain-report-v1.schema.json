{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-gain-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "provider_lock_sha256",
    "output_sha256",
    "output_bytes",
    "output_pcm_sha256",
    "sample_rate_hz",
    "channels",
    "frame_count",
    "output_policy_status",
    "runtime_qualified",
    "creative_approval",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-gain-report/v1"
    },
    "operation": {
      "$ref": "audio-gain-operation-v1.schema.json"
    },
    "provider_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "output_pcm_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_rate_hz": {
      "enum": [
        44100,
        48000
      ]
    },
    "channels": {
      "enum": [
        1,
        2
      ]
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28800000
    },
    "output_policy_status": {
      "const": "requires_fresh_exact_file_qc"
    },
    "runtime_qualified": {
      "const": false
    },
    "creative_approval": {
      "const": "not_performed"
    },
    "publication_authority": {
      "const": "none"
    }
  },
  "description": "Explicit requested fixed-gain candidate. Native/goal/creative/platform qualification is not inferred; current output QC is still required."
}
