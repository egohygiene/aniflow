{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.finishing-plan/v1",
  "$comment": "Authored and unvalidated. Rust rechecks exact current native acceptance, immutable intent and supplied preview declaration. No full creative review, native qualification or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.finishing-plan/v1"
    },
    "intent": {
      "$ref": "finishing-intent-v1.schema.json"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "state",
          "plan",
          "run_directory",
          "native_manifest_sha256"
        ],
        "properties": {
          "phase": {
            "enum": [
              "caption_preview",
              "caption_review",
              "caption_delivery",
              "metadata_remux"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "incomplete",
              "awaiting_review",
              "rejected",
              "complete"
            ]
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "pipeline-v3-plan-v1.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_directory": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^/"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_manifest_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
