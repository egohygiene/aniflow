{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.release-evidence-handoff/v1",
  "$comment": "Authored/unvalidated. Exact public field projection only; hashes/OTS subject relationships do not authenticate identity, Bitcoin time, current producers or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "version",
    "subjects",
    "evidence_scope",
    "signature_state",
    "timestamp_state",
    "ownership",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.release-evidence-handoff/v1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "sha256",
          "byte_count",
          "parents",
          "proof"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "role": {
            "enum": [
              "original",
              "milestone",
              "final_delivery",
              "sidecar",
              "production_evidence"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627776
          },
          "parents": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "proof": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "subject_sha256",
                  "proof_sha256",
                  "proof_byte_count",
                  "operation_count",
                  "pending_calendar_count",
                  "bitcoin_claim_count",
                  "unknown_attestation_count",
                  "subject_binding",
                  "timestamp_state",
                  "availability"
                ],
                "properties": {
                  "profile": {
                    "const": "aniflow.ots-v1-sha256-commitments/v1"
                  },
                  "subject_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "proof_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "proof_byte_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "operation_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  },
                  "pending_calendar_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 128
                  },
                  "bitcoin_claim_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 128
                  },
                  "unknown_attestation_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 128
                  },
                  "subject_binding": {
                    "const": "matches_selected_subject_sha256; timestamp_not_verified"
                  },
                  "timestamp_state": {
                    "const": "not_verified"
                  },
                  "availability": {
                    "const": "proof_bytes_not_included; separate_disclosure_required"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "evidence_scope": {
      "const": "archival_bytes_only; producer_acceptance_not_reobserved"
    },
    "signature_state": {
      "const": "not_signed"
    },
    "timestamp_state": {
      "const": "not_verified"
    },
    "ownership": {
      "const": "not_established"
    },
    "publication_authority": {
      "const": "none"
    }
  }
}
