{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-midi-export/v1",
  "title": "audio MIDI export evidence v1",
  "description": "Closed bounded MIDI candidate contract. Rust additionally checks exact identities, canonical source timing, note order and overlap, source-relative bounds, deterministic note/tick derivation and MIDI bytes. Candidate activation is not calibrated confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "source_report",
    "source_audio",
    "notes",
    "midi",
    "profile",
    "mappings",
    "read_back",
    "note_count",
    "empty_candidate"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-midi-export/v1"
    },
    "authority": {
      "const": "candidate"
    },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "midi"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "source_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "source_audio"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 44,
          "maximum": 268435456
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "midi_notes"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "midi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "midi_candidate"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 36,
          "maximum": 262144
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "tracks",
        "ticks_per_quarter",
        "microseconds_per_quarter",
        "channel",
        "program",
        "tick_rounding",
        "maximum_tick_error_seconds",
        "inferred_source_tempo",
        "inferred_source_instrument"
      ],
      "properties": {
        "format": {
          "const": 0
        },
        "tracks": {
          "const": 1
        },
        "ticks_per_quarter": {
          "const": 960
        },
        "microseconds_per_quarter": {
          "const": 500000
        },
        "channel": {
          "const": 0
        },
        "program": {
          "const": 0
        },
        "tick_rounding": {
          "const": "nearest_tick_ties_up"
        },
        "maximum_tick_error_seconds": {
          "const": {
            "numerator": 1,
            "denominator": 3840
          }
        },
        "inferred_source_tempo": {
          "const": false
        },
        "inferred_source_instrument": {
          "const": false
        }
      }
    },
    "mappings": {
      "const": [
        "native_times_rounded_to_microseconds",
        "candidate_times_rounded_to_midi_ticks",
        "activation_retained_in_companion",
        "placeholder_channel_and_program",
        "pitch_bends_unavailable",
        "fixed_tempo_is_clock_only"
      ]
    },
    "read_back": {
      "$ref": "#/$defs/readBack"
    },
    "note_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "empty_candidate": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "empty_candidate": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "note_count": {
            "const": 0
          },
          "read_back": {
            "properties": {
              "notes": {
                "maxItems": 0
              }
            }
          },
          "midi": {
            "properties": {
              "byte_size": {
                "const": 36
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "note_count": {
            "minimum": 1
          },
          "read_back": {
            "properties": {
              "notes": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "readBack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "tracks",
        "ticks_per_quarter",
        "microseconds_per_quarter",
        "channel",
        "program",
        "notes"
      ],
      "properties": {
        "format": {
          "const": 0
        },
        "tracks": {
          "const": 1
        },
        "ticks_per_quarter": {
          "const": 960
        },
        "microseconds_per_quarter": {
          "const": 500000
        },
        "channel": {
          "const": 0
        },
        "program": {
          "const": 0
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/readBackNote"
          }
        }
      }
    },
    "readBackNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_tick",
        "end_tick",
        "pitch",
        "velocity"
      ],
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 230400
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 230400
        },
        "pitch": {
          "type": "integer",
          "minimum": 21,
          "maximum": 108
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  }
}
