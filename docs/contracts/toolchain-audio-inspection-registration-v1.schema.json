{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-audio-inspection-registration-v1.schema.json",
  "title": "aniflow explicit audio-inspection registration request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aniflow.toolchain.audio-inspection-registration/v1"
    },
    "registration_directory": {
      "$ref": "#/$defs/absolute_directory"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "tool_timeout_milliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "maximum_tool_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    }
  },
  "required": [
    "schema",
    "registration_directory",
    "adapter",
    "preflight",
    "source",
    "tool_timeout_milliseconds",
    "maximum_tool_output_bytes"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "portable_locator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:<>\\u0022|?*])(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "maxLength": 4096,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        {
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn][Ff][Ii][Gg][Uu][Rr][Aa][Tt][Ii][Oo][Nn]\\.[Jj][Ss][Oo][Nn]|[Mm][Aa][Nn][Ii][Ff][Ee][Ss][Tt]\\.[Jj][Ss][Oo][Nn]|[Pp][Rr][Ee][Ff][Ll][Ii][Gg][Hh][Tt]\\.[Jj][Ss][Oo][Nn]|[Rr][Ee][Gg][Ii][Ss][Tt][Rr][Aa][Tt][Ii][Oo][Nn]\\.[Jj][Ss][Oo][Nn])(?:/|$)"
          }
        }
      ]
    },
    "absolute_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)"
          }
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        }
      ]
    },
    "preflight_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_profile_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_profile_platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "preflight_profile_dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "kind": {
          "enum": [
            "tool",
            "model"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "version_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "package_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/preflight_profile_sha256"
        },
        "required_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "required_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "native_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "suggested_locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/?#\\s\\u0000-\\u001f\\u007f-\\u009f]+(?:[^\\s\\u0000-\\u001f\\u007f-\\u009f]*)$",
            "maxLength": 2048
          },
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "kind",
        "optional",
        "required_flags",
        "required_features",
        "suggested_locators"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "native_scale"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "model"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "version_requirement"
              ]
            },
            "properties": {
              "required_flags": {
                "maxItems": 0
              },
              "required_features": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "preflight_profile_backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "required_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "name",
        "required_features"
      ]
    },
    "preflight_profile_scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "requested": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "mode": {
          "enum": [
            "native",
            "post_resize"
          ]
        }
      },
      "required": [
        "native",
        "requested",
        "mode"
      ]
    },
    "preflight_profile_capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/preflight_profile_id"
        },
        "optional": {
          "type": "boolean"
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_id"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 128
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_profile_platform"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 32
        },
        "backend": {
          "$ref": "#/$defs/preflight_profile_backend"
        },
        "scale": {
          "$ref": "#/$defs/preflight_profile_scale"
        },
        "effective_settings": {
          "type": "object"
        },
        "side_effects": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem_read",
              "filesystem_write",
              "environment_read",
              "subprocess",
              "network",
              "ai",
              "gpu",
              "publish"
            ]
          },
          "uniqueItems": true,
          "maxItems": 8
        }
      },
      "required": [
        "id",
        "optional",
        "dependency_ids",
        "platforms",
        "effective_settings",
        "side_effects"
      ]
    },
    "preflight_inventory_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_inventory_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "preflight_inventory_platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "preflight_inventory_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable_sha256": {
          "$ref": "#/$defs/preflight_inventory_sha256"
        },
        "version": {
          "$ref": "#/$defs/preflight_inventory_text"
        },
        "package_revision": {
          "$ref": "#/$defs/preflight_inventory_text"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 4096
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "native_scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "executable_sha256",
        "flags",
        "features",
        "provenance"
      ]
    },
    "preflight_inventory_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "$ref": "#/$defs/preflight_inventory_id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
        },
        "expected_sha256": {
          "$ref": "#/$defs/preflight_inventory_sha256"
        },
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824,
          "default": 536870912
        },
        "observation": {
          "$ref": "#/$defs/preflight_inventory_observation"
        }
      },
      "required": [
        "dependency_id",
        "path",
        "expected_sha256"
      ]
    },
    "preflight_inventory_hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/preflight_inventory_id"
        },
        "available": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_inventory_text"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "name",
        "available",
        "features",
        "provenance"
      ]
    },
    "preflight_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "registration_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_id"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "ffmpeg_dependency_id": {
          "$ref": "#/$defs/preflight_id"
        },
        "ffprobe_dependency_id": {
          "$ref": "#/$defs/preflight_id"
        }
      },
      "required": [
        "stage_id",
        "registration_id",
        "capability_ids",
        "ffmpeg_dependency_id",
        "ffprobe_dependency_id"
      ]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aniflow.toolchain.preflight/v1"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "aniflow.toolchain-profile/v1"
            },
            "id": {
              "$ref": "#/$defs/preflight_profile_id"
            },
            "default_capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_id"
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 64
            },
            "dependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_dependency"
              },
              "minItems": 1,
              "maxItems": 128
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_profile_capability"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "schema",
            "id",
            "default_capabilities",
            "dependencies",
            "capabilities"
          ]
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "aniflow.toolchain-inventory/v1"
            },
            "platform": {
              "$ref": "#/$defs/preflight_inventory_platform"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_inventory_artifact"
              },
              "maxItems": 128
            },
            "hardware": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preflight_inventory_hardware"
              },
              "maxItems": 32
            }
          },
          "required": [
            "schema",
            "platform",
            "artifacts",
            "hardware"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflight_binding"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "schema",
        "profile",
        "inventory",
        "bindings"
      ]
    },
    "native_absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ]
    },
    "native_semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "native_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "native_toolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/native_absolutePath"
        },
        "version": {
          "$ref": "#/$defs/native_semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/native_sha256"
        }
      }
    },
    "native_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ffmpeg",
        "ffprobe",
        "tool_timeout_milliseconds",
        "maximum_tool_output_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-inspection.configuration/v1"
        },
        "ffmpeg": {
          "$ref": "#/$defs/native_toolPin"
        },
        "ffprobe": {
          "$ref": "#/$defs/native_toolPin"
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "source_audio"
        },
        "sha256": {
          "$ref": "#/$defs/native_sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 44,
          "maximum": 268435456
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/portable_locator"
        },
        "implementation_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "required": [
        "relative_path",
        "implementation_id",
        "expected_sha256",
        "maximum_bytes"
      ]
    }
  },
  "$comment": "One MiB request limit and UTF-8 byte limits are enforced in Rust. Rust also verifies exactly one binding, dependency mappings, host and declaration consistency, a pre-existing nonsymlink registration directory, confined nonsymlink executable adapter, and fresh bounded file hashes. The source is a declaration, not a path to read or media qualification."
}
