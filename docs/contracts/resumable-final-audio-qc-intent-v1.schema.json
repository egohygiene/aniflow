{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.resumable-final-audio-qc-intent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "native",
    "projected_working_bytes",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.resumable-final-audio-qc-intent/v1"
    },
    "request": {
      "$ref": "resumable-final-audio-qc-request-v1.schema.json"
    },
    "native": {
      "$ref": "final-lossless-audio-qc-intent-v2.schema.json"
    },
    "projected_working_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "description": "Immutable current source/components/native intent and finite 16 MiB extra metadata allowance; no future output hashes. Closed private transition evidence. Shape alone establishes no current native acceptance, review or publication authority. Authored, unvalidated; all runtime qualification remains deferred."
}
