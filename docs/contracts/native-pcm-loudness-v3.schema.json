{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pcm_sha256",
    "frames",
    "sample_rate_hz",
    "channels",
    "integrated_loudness",
    "true_peak",
    "method",
    "commands",
    "runtime_qualified"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.native-pcm-loudness/v3"
    },
    "pcm_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frames": {
      "type": "integer",
      "minimum": 1
    },
    "sample_rate_hz": {
      "const": 44100
    },
    "channels": {
      "enum": [
        1,
        2
      ]
    },
    "integrated_loudness": {
      "$ref": "audio-signal-measurements-v2.schema.json#/properties/integrated_loudness"
    },
    "true_peak": {
      "$ref": "audio-signal-measurements-v2.schema.json#/properties/true_peak"
    },
    "method": {
      "const": "Existing #13 FFmpeg 8.0.1 ebur128 two-pass meter/parser, 44.1 kHz native PCM16/PCM24/float32; original-rate windows and independent native sample peak; no quantization, resampling or downmix"
    },
    "commands": {
      "$ref": "audio-signal-measurements-v2.schema.json#/properties/commands"
    },
    "runtime_qualified": {
      "const": false
    }
  },
  "$id": "aniflow.native-pcm-loudness/v3"
}
