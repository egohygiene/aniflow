{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.upscayl-recovery-inventory/v1",
  "$comment": "Authored/unvalidated source contract; qualification remains deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "manifest_sha256",
    "frames",
    "units",
    "collection_state",
    "output_reuse_authority",
    "estimated_remaining_milliseconds"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.upscayl-recovery-inventory/v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "complete",
        "pending",
        "active_or_uncertain",
        "failed",
        "cancelled",
        "invalidated"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "active_or_uncertain": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "invalidated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "frame_count",
          "state",
          "checkpoint_sha256",
          "rerun_required"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "frame_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "validating",
              "complete",
              "failed",
              "cancelled",
              "invalidated",
              "skipped"
            ]
          },
          "checkpoint_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rerun_required": {
            "type": "boolean"
          }
        }
      }
    },
    "collection_state": {
      "enum": [
        "pending",
        "running",
        "validating",
        "complete",
        "failed",
        "cancelled",
        "invalidated",
        "skipped"
      ]
    },
    "output_reuse_authority": {
      "const": "none; explicit native resume must freshly validate outputs and resolve interrupted attempts"
    },
    "estimated_remaining_milliseconds": {
      "type": "null"
    }
  }
}
