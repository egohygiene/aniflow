{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"aniflow.posting-plan/v1",
  "description":"Private read-only expected package/review bindings. No declaration or approval is created; runtime rechecks accepted media before any copy.",
  "type":"object","additionalProperties":false,"required":["schema","request_sha256","review_context_sha256","review_subject_sha256","media_filename","projected_package_bytes","metadata_scope","publication_authority"],
  "properties":{
    "schema":{"const":"aniflow.posting-plan/v1"},"request_sha256":{"$ref":"#/$defs/sha256"},"review_context_sha256":{"$ref":"#/$defs/sha256"},"review_subject_sha256":{"$ref":"#/$defs/sha256"},
    "media_filename":{"enum":["delivery.mp4","audio.wav"]},"projected_package_bytes":{"type":"integer","minimum":1,"maximum":1099511627776},"metadata_scope":{"type":"string"},"publication_authority":{"const":"none"}
  },"$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
