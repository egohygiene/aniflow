{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.amv-evidence-packet/v1",
  "$comment": "Authored/unvalidated. Current native acceptance and exact citations remain Rust checks; no model/media review or semantic grounding is established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_sha256",
    "context_sha256",
    "artifact_sha256",
    "checkpoint_sha256",
    "frame_count",
    "frame_rate",
    "selected_final_video_interval",
    "facts",
    "omissions",
    "media_samples",
    "full_movie_reviewed"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.amv-evidence-packet/v1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "frame_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selected_final_video_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer"
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer"
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "record_sha256",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "count"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "width",
                  "height"
                ],
                "properties": {
                  "kind": {
                    "const": "geometry"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "rational"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "properties": {
                      "numerator": {
                        "type": "integer"
                      },
                      "denominator": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "interval"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer"
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      "end": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer"
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "flag"
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "media_samples": {
      "const": 0
    },
    "full_movie_reviewed": {
      "const": false
    }
  }
}
