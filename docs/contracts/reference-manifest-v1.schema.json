{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "aniflow.reference-manifest/v1",
  "description": "Source-bound sparse reference images. Rust recomputes ordered selection/reasons/intervals and fixed filenames. Wire shape grants neither runtime acceptance nor visual approval; samples cannot reconstruct the complete video.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "source_sha256", "source_byte_count", "source_frames", "source_period", "width", "height", "policy", "ffmpeg", "ffprobe", "images", "conversion", "native_qualified"],
  "properties": {
    "schema": {"const": "aniflow.reference-manifest/v1"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "source_byte_count": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "source_frames": {"type": "integer", "minimum": 1, "maximum": 100000},
    "source_period": {"$ref": "temporal-inspection-v1.schema.json#/$defs/rational"},
    "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
    "policy": {"$ref": "reference-sampling-v1.schema.json"},
    "ffmpeg": {"$ref": "#/$defs/tool"}, "ffprobe": {"$ref": "#/$defs/tool"},
    "images": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/image"}},
    "conversion": {"const": "explicit_bt709_source_to_full_range_rgb24"}, "native_qualified": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"enum": ["ffmpeg", "ffprobe"]}, "version": {"const": "8.0.1"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_ordinal", "source_ordinal", "source_time", "reasons", "filename", "sha256", "byte_count", "decoded_rgb24_sha256"],
      "properties": {
        "sample_ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "source_ordinal": {"type": "integer", "minimum": 0, "maximum": 99999},
        "source_time": {"$ref": "temporal-inspection-v1.schema.json#/$defs/range"},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["first", "periodic", "last"]}},
        "filename": {"type": "string", "pattern": "^frame-[0-9]{8}\\.png$"},
        "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "decoded_rgb24_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
