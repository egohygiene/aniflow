{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_directory",
    "context_sha256",
    "bypassed",
    "complete",
    "native_manifest_sha256",
    "comparison_directory",
    "report",
    "review",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.deflicker-comparison-status/v1"
    },
    "run_directory": {
      "type": "string",
      "minLength": 1
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bypassed": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "native_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison_directory": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "anyOf": [
        {
          "$ref": "deflicker-comparison-report-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "$ref": "finishing-status-v1.schema.json#/properties/review"
    },
    "publication_authority": {
      "const": "none; excerpt_review_does_not_approve_full_video"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.deflicker-comparison-status/v1",
  "description": "Explicit short silent visual comparison, authored/unvalidated. Native v3 acceptance, supplied excerpt review and full-video publication remain separate. No perceptual/native qualification is inferred."
}
