{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/source-music-video-status-v1.schema.json",
  "title": "aniflow observed source-entry music-video status v1",
  "description": "Read-only observation of one root and four fixed child locations. Accepted extraction must establish the original frame set before the shared indexed tail can proceed. Null geometry and target evidence mean unresolved, never a guessed resolution or target bypass. Child manifests and final outputs retain existing v3 acceptance authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_directory", "intent_sha256", "complete", "output_width", "output_height", "target_resolution", "phases", "outputs"],
  "properties": {
    "schema": { "const": "aniflow.source-music-video-status/v1" },
    "run_directory": { "$ref": "music-video-intent-v1.schema.json#/$defs/absolutePath" },
    "intent_sha256": { "$ref": "music-video-intent-v1.schema.json#/$defs/sha256" },
    "complete": { "type": "boolean" },
    "output_width": { "$ref": "#/$defs/pendingDimension" },
    "output_height": { "$ref": "#/$defs/pendingDimension" },
    "target_resolution": { "anyOf": [{ "$ref": "music-video-intent-v1.schema.json#/$defs/targetResolution" }, { "type": "null" }] },
    "phases": { "$ref": "#/$defs/phases" },
    "outputs": { "type": "array", "items": { "$ref": "pipeline-run-outcome-v1.schema.json#/$defs/output" } }
  },
  "$defs": {
    "dimension": { "type": "integer", "minimum": 2, "maximum": 4294967295, "multipleOf": 2 },
    "pendingDimension": { "anyOf": [{ "$ref": "#/$defs/dimension" }, { "type": "null" }] },
    "phaseStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "state", "reason", "run_directory", "plan_sha256", "manifest"],
      "properties": {
        "phase": { "$ref": "source-music-video-intent-v1.schema.json#/$defs/phase" },
        "state": { "enum": ["disabled", "pending", "ready", "running", "complete", "failed", "cancelled", "incomplete_initialization", "already_target", "above_target"] },
        "reason": { "type": ["string", "null"] },
        "run_directory": { "anyOf": [{ "$ref": "music-video-intent-v1.schema.json#/$defs/absolutePath" }, { "type": "null" }] },
        "plan_sha256": { "anyOf": [{ "$ref": "music-video-intent-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "manifest": { "anyOf": [{ "$ref": "pipeline-run-v1.schema.json" }, { "type": "null" }] }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/phaseStatus" }, { "properties": { "phase": { "const": "extract_frames" } } }] },
        { "allOf": [{ "$ref": "#/$defs/phaseStatus" }, { "properties": { "phase": { "const": "prepare_frames" } } }] },
        { "allOf": [{ "$ref": "#/$defs/phaseStatus" }, { "properties": { "phase": { "const": "upscale" } } }] },
        { "allOf": [{ "$ref": "#/$defs/phaseStatus" }, { "properties": { "phase": { "const": "assembly" } } }] }
      ]
    }
  }
}
