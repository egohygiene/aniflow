{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-media-setup-v1.schema.json",
  "title": "aniflow selected media setup request v1",
  "description": "Prepare one explicit selected media configuration from current local identities and supplied dependency observations. Destination export maps closed profile/geometry/metadata/bounds to exact FFmpeg/ffprobe roles; optional caption readiness uses its own pinned font. No native probe, source media, install, download, setup write or provider launch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "inventory",
    "capability_id",
    "selection"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.toolchain.media-setup/v1"
    },
    "profile": {
      "$ref": "toolchain-profile-v1.schema.json"
    },
    "inventory": {
      "$ref": "toolchain-inventory-v1.schema.json"
    },
    "capability_id": {
      "$ref": "#/$defs/identifier"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ffmpeg_dependency_id",
            "ffprobe_dependency_id"
          ],
          "properties": {
            "kind": {
              "const": "caption_rendering"
            },
            "ffmpeg_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "ffprobe_dependency_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "processor_dependency_id",
            "param_dependency_id",
            "weights_dependency_id"
          ],
          "properties": {
            "kind": {
              "const": "rife_interpolation"
            },
            "processor_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "param_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "weights_dependency_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ffmpeg_dependency_id",
            "processor_dependency_id"
          ],
          "properties": {
            "kind": {
              "const": "allenk_image_repair"
            },
            "ffmpeg_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "processor_dependency_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ffmpeg_dependency_id",
            "processor_dependency_id",
            "param_dependency_id",
            "weights_dependency_id"
          ],
          "properties": {
            "kind": {
              "const": "upscayl_recovery"
            },
            "ffmpeg_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "processor_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "param_dependency_id": {
              "$ref": "#/$defs/identifier"
            },
            "weights_dependency_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ffmpeg_dependency_id",
            "ffprobe_dependency_id"
          ],
          "properties": {
            "kind": {
              "const": "destination_video"
            },
            "ffmpeg_dependency_id": {
              "type": "string",
              "minLength": 1
            },
            "ffprobe_dependency_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "import_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_timeout_milliseconds",
        "maximum_source_bytes",
        "maximum_frame_bytes",
        "maximum_total_frame_bytes",
        "maximum_pixels"
      ],
      "properties": {
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "maximum_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "maximum_total_frame_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      }
    },
    "allenk_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import",
        "watermark_profile",
        "detection_threshold_percent",
        "maximum_working_bytes"
      ],
      "properties": {
        "import": {
          "$ref": "#/$defs/import_options"
        },
        "watermark_profile": {
          "enum": [
            "current_v2",
            "legacy_v1"
          ]
        },
        "detection_threshold_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_working_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 17592186044416
        }
      }
    },
    "upscayl_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import",
        "model_name",
        "native_scale",
        "output_scale",
        "tile_size",
        "gpu_id",
        "threads",
        "tta",
        "maximum_output_frame_bytes",
        "maximum_output_pixels",
        "maximum_working_bytes",
        "minimum_free_bytes"
      ],
      "properties": {
        "import": {
          "$ref": "#/$defs/import_options"
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "native_scale": {
          "const": 4
        },
        "output_scale": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "tile_size": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        "gpu_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "threads": {
          "const": "1:1:1"
        },
        "tta": {
          "type": "boolean"
        },
        "maximum_output_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 268435456
        },
        "maximum_output_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "maximum_working_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 17592186044416
        },
        "minimum_free_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      }
    },
    "caption_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media",
        "mode",
        "font",
        "style",
        "preview_cue_indices"
      ],
      "properties": {
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_milliseconds",
            "maximum_capture_bytes",
            "maximum_source_bytes",
            "maximum_output_bytes",
            "maximum_frame_bytes",
            "maximum_total_frame_bytes",
            "maximum_pixels",
            "maximum_working_bytes",
            "minimum_free_bytes",
            "delivery_crf",
            "preset"
          ],
          "properties": {
            "timeout_milliseconds": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/timeout_milliseconds"
            },
            "maximum_capture_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_capture_bytes"
            },
            "maximum_source_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_source_bytes"
            },
            "maximum_output_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_output_bytes"
            },
            "maximum_frame_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_frame_bytes"
            },
            "maximum_total_frame_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_total_frame_bytes"
            },
            "maximum_pixels": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_pixels"
            },
            "maximum_working_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/maximum_working_bytes"
            },
            "minimum_free_bytes": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/minimum_free_bytes"
            },
            "delivery_crf": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/delivery_crf"
            },
            "preset": {
              "$ref": "../../providers/video-assembly/configuration.schema.json#/properties/preset"
            }
          }
        },
        "mode": {
          "$ref": "caption-configuration-v1.schema.json#/properties/mode"
        },
        "font": {
          "$ref": "caption-configuration-v1.schema.json#/properties/font"
        },
        "style": {
          "$ref": "caption-configuration-v1.schema.json#/properties/style"
        },
        "preview_cue_indices": {
          "$ref": "caption-configuration-v1.schema.json#/properties/preview_cue_indices"
        }
      }
    }
  },
  "$comment": "Rust selects the closed options type by the explicit selection and capability_id, checks exact dependency roles/effects/backend/scale/settings and current local identities. Caption font remains a typed bounded local asset in effective settings, not a neural model. Attributed flags/features/version observations are not live probes or native qualification. No setup writes, service, download, registration or media access."
}
