{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"aniflow.lossless-audio-report/v1",
  "description":"PRIVATE fixed native producer observation, not independent codec qualification. Existing v3 acceptance and current original signal/native byte bindings must recheck; a loose or rehashed report is not authority.",
  "type":"object","additionalProperties":false,
  "required":["schema","operation","provider_lock_sha256","output_sha256","output_byte_count","decoded_pcm_sha256","sample_rate_hz","channels","frame_count","encoding","verification_method","signal_changes","metadata_scope","after_export_meter","native_qualified","creative_approval","publication_authority"],
  "properties":{"schema":{"const":"aniflow.lossless-audio-report/v1"},"operation":{"$ref":"lossless-audio-operation-v1.schema.json"},"provider_lock_sha256":{"$ref":"lossless-audio-operation-v1.schema.json#/$defs/sha256"},"output_sha256":{"$ref":"lossless-audio-operation-v1.schema.json#/$defs/sha256"},"output_byte_count":{"type":"integer","minimum":1,"maximum":268435456},"decoded_pcm_sha256":{"$ref":"lossless-audio-operation-v1.schema.json#/$defs/sha256"},
    "sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},"channels":{"type":"integer","minimum":1,"maximum":2},"frame_count":{"type":"integer","minimum":1,"maximum":115200000},"encoding":{"$ref":"destination-preflight-request-v1.schema.json#/$defs/encoding"},
    "verification_method":{"const":"native_container_fields_and_pinned_ffmpeg_full_pcm_sha256; codec_implementation_not_independent"},"signal_changes":{"const":"none"},"metadata_scope":{"const":"inherited_descriptive_tags_removed; regenerated_encoder_vendor_and_structural_fields_excluded; signature_or_signal_absence_not_asserted"},
