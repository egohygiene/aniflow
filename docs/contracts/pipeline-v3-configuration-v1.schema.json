{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/pipeline-v3-configuration-v1.schema.json",
  "title": "aniflow Pipeline v3 authored configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "inputs", "stages", "outputs"],
  "properties": {
    "schema": { "const": "aniflow.pipeline/v3" },
    "name": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finalOutput" }
    }
  },
  "$defs": {
    "printableText": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "artifactRole": {
      "enum": [
        "temporal_source",
        "temporal_component",
        "intermediate",
        "candidate_master",
        "validated_master",
        "validation_evidence",
        "run_evidence",
        "delivery_receipt"
      ]
    },
    "streamRole": {
      "enum": [
        "video",
        "audio",
        "subtitle",
        "transcript",
        "timed_metadata",
        "attachment"
      ]
    },
    "providerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_id"],
      "properties": {
        "registration_id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_type", "artifact_role"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact_type": { "$ref": "#/$defs/artifactType" },
        "artifact_role": { "$ref": "#/$defs/artifactRole" },
        "stream_role": { "$ref": "#/$defs/streamRole" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_requirement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version_requirement": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        }
      }
    },
    "providerSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "replacement": { "$ref": "#/$defs/providerCandidate" },
        "primary": { "$ref": "#/$defs/providerCandidate" },
        "fallbacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerCandidate" }
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "artifacts"],
      "properties": {
        "port": { "$ref": "#/$defs/localId" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        }
      }
    },
    "expectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:<>\\u0022|?*])(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))artifacts/[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "kind": { "enum": ["file", "directory"] }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "artifacts"],
      "properties": {
        "port": { "$ref": "#/$defs/localId" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectedArtifact" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "contract"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact": { "$ref": "#/$defs/localId" },
        "contract": { "$ref": "#/$defs/printableText" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "provider", "inputs", "outputs"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "capability": { "$ref": "#/$defs/capabilityRequirement" },
        "provider": { "$ref": "#/$defs/providerSelection" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputBinding" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputBinding" }
        },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation" }
        }
      }
    },
    "finalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "required_validations"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact": { "$ref": "#/$defs/localId" },
        "required_validations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        }
      }
    }
  }
}
