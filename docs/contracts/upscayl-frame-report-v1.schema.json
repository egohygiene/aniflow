{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.upscayl-frame-report/v1",
  "title": "aniflow observed Upscayl frame v1",
  "description": "One native-wrapper observation. Source/index/time, exact effective settings, pins, output geometry and decoded input/output bytes require runtime checks. The ordinary stage checkpoint establishes acceptance; a loose JSON report does not. Native model scale/version declarations, GPU/backend qualification and visual quality are distinct from observed output bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage_id",
    "provider_lock_sha256",
    "configuration_sha256",
    "frame",
    "upscayl_sha256",
    "decoder_sha256",
    "model_param_sha256",
    "model_weights_sha256",
    "native_scale",
    "output_scale",
    "output_width",
    "output_height",
    "output_sha256",
    "output_byte_count",
    "input_decoded_rgb24_sha256",
    "output_decoded_rgb24_sha256",
    "processor_elapsed_milliseconds",
    "backend_qualification"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.upscayl-frame-report/v1"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^upscale_frame_[0-9]{6}$"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "upscayl_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decoder_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_param_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_weights_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "native_scale": {
      "const": 4
    },
    "output_scale": {
      "enum": [
        2,
        3,
        4
      ]
    },
    "output_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "output_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "output_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "output_byte_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "input_decoded_rgb24_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "output_decoded_rgb24_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "processor_elapsed_milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "backend_qualification": {
      "const": "unqualified"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/rational"
        },
        "end": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "source_byte_count",
        "frame_index_sha256",
        "ordinal",
        "filename",
        "source_time",
        "input_sha256",
        "input_byte_count",
        "input_width",
        "input_height"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "frame_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.png$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "source_time": {
          "$ref": "#/$defs/range"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "input_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "input_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
