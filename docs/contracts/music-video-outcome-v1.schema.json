{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/music-video-outcome-v1.schema.json",
  "title": "aniflow music-video recipe outcome v1",
  "description": "Successful fixed-recipe result referencing existing accepted child runs and final assembly outputs. This aggregates current runtime authority; it introduces no separate completion record, artifact adoption, historical frame provenance, visual approval or native qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_directory", "intent_sha256", "phases", "outputs"],
  "properties": {
    "schema": { "const": "aniflow.music-video-outcome/v1" },
    "run_directory": { "$ref": "music-video-intent-v1.schema.json#/$defs/absolutePath" },
    "intent_sha256": { "$ref": "music-video-intent-v1.schema.json#/$defs/sha256" },
    "phases": {
      "allOf": [
        { "$ref": "music-video-status-v1.schema.json#/$defs/phases" },
        { "items": { "properties": { "state": { "enum": ["disabled", "complete"] } } } }
      ]
    },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "pipeline-run-outcome-v1.schema.json#/$defs/output" } }
  }
}
