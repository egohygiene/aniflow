{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.timed-text/v1",
  "title": "normalized timed-text document v1",
  "description": "Closed timed-text v1 shape. UTF-8 byte lengths, reduced rationals, source-time bounds, overlap/identity consistency, reviewed source binding and loss authorization are additionally validated by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "provenance",
    "overlap_policy",
    "metadata",
    "cues"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.timed-text/v1"
    },
    "source": {
      "$ref": "#/$defs/sourceText"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "language": {
      "anyOf": [
        {
          "$ref": "#/$defs/language"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/audioSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "overlap_policy": {
      "enum": [
        "reject",
        "allow"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/cue"
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "$ref": "#/$defs/safeInteger"
        }
      }
    },
    "audioSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "byte_size": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 768000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "frame_count": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "origin": {
          "$ref": "#/$defs/sourceOrigin"
        },
        "stem": {
          "anyOf": [
            {
              "$ref": "#/$defs/stemIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Bounded v1 profile: one zero-origin selected audio stream, index 0. Generalized container/stream mappings are deferred."
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "timing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/cueId"
        },
        "source_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/cueText"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "speaker": {
          "anyOf": [
            {
              "$ref": "#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
    },
    "cueText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]"
      }
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/metadataKey"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
        }
      }
    },
    "metadataKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unreviewed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "producer"
          ],
          "properties": {
            "kind": {
              "const": "observed_transcript"
            },
            "producer": {
              "$ref": "#/$defs/shortText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "authority",
            "evidence",
            "source_sha256"
          ],
          "properties": {
            "kind": {
              "const": "reviewed_lyrics"
            },
            "authority": {
              "$ref": "#/$defs/reviewAuthority"
            },
            "evidence": {
              "$ref": "#/$defs/reviewEvidence"
            },
            "source_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "reviewAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplied_by",
        "provenance_artifact_id"
      ],
      "properties": {
        "supplied_by": {
          "$ref": "#/$defs/shortText"
        },
        "provenance_artifact_id": {
          "$ref": "#/$defs/cueId"
        }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/cueId",
          "not": {
            "const": "source_text"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "sourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "const": 0
        },
        "denominator": {
          "const": 1
        }
      }
    },
    "sourceText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "source_text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "stemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_mix",
        "relationship_evidence_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "original_mix": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "byte_size": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        "relationship_evidence_id": {
          "$ref": "#/$defs/localId"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "denominator": {
          "enum": [
            1,
            2,
            4,
            5,
            8,
            10,
            20,
            25,
            40,
            50,
            100,
            125,
            200,
            250,
            500,
            1000
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 86400
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 172800
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 345600
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 432000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 8
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 691200
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 10
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 864000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 20
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 1728000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 25
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 2160000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 40
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 3456000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 50
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 4320000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 100
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 8640000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 125
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 10800000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 200
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 17280000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 250
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 21600000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 500
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 43200000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 1000
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 86400000
              }
            }
          }
        }
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "untimed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "at"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "at": {
              "$ref": "#/$defs/time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "interval"
            },
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        }
      ]
    }
  }
}
