{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.upscayl-recovery-report/v1",
  "title": "aniflow collected Upscayl recovery observations v1",
  "description": "Complete observations collected from the same run's accepted frame dependencies. Rust checks every frame mapping, operation identity, output digest and complete cardinality. Deserialization or schema validity is not historical import or runtime acceptance. Source relationship remains declared, historical processing unknown, and backend/native/visual qualification unestablished.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage_id",
    "provider_lock_sha256",
    "configuration_sha256",
    "source_relationship",
    "historical_processing",
    "backend_qualification",
    "output_index",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.upscayl-recovery-report/v1"
    },
    "stage_id": {
      "const": "collect_upscaled_frames"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_relationship": {
      "const": "declared_not_verified"
    },
    "historical_processing": {
      "const": "unknown"
    },
    "backend_qualification": {
      "const": "unqualified"
    },
    "output_index": {
      "$ref": "upscayl-output-index-v1.schema.json"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "upscayl-frame-report-v1.schema.json"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  }
}
