{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/native-validation-configuration-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ffmpeg",
    "ffprobe",
    "maximum_media_bytes",
    "decode_timeout_seconds"
  ],
  "properties": {
    "ffmpeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "version": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ffprobe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "version": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "maximum_media_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    },
    "decode_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
