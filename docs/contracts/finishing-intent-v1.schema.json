{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.finishing-intent/v1",
  "$comment": "Authored and unvalidated. Rust rechecks exact current native acceptance, immutable intent and supplied preview declaration. No full creative review, native qualification or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "payload",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.finishing-intent/v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "source",
        "components",
        "initial_plan_sha256"
      ],
      "properties": {
        "request": {
          "$ref": "finishing-request-v1.schema.json"
        },
        "source": {
          "$ref": "final-video-handoff-v1.schema.json"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byte_count"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "initial_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
