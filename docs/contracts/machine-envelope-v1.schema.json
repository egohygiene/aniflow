{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/machine-envelope-v1.schema.json",
  "title": "aniflow machine envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "enum": [
        "doctor",
        "toolchain_doctor",
        "toolchain_plan",
        "toolchain_probe",
        "toolchain_prepare_registration",
        "toolchain_prepare_media",
        "inspect",
        "temporal_inspect",
        "audio_plan",
        "audio_inspect",
        "audio_analyze",
        "audio_resume",
        "audio_transcribe",
        "audio_transcript_export",
        "audio_lyrics_align",
        "audio_lyrics_export",
        "audio_midi_extract",
        "audio_midi_export",
        "video_interpolation_plan",
        "video_frame_selection_plan",
        "video_import_frames",
        "video_repair_frames",
        "video_upscale_frames",
        "video_upscale_preview",
        "video_assemble_frames",
        "video_extract_frames",
        "video_music_video",
        "video_music_video_status",
        "video_completion",
        "video_frame_review_status",
        "video_frame_review_record",
        "video_rife_plan",
        "video_rife_run",
        "video_rife_resume",
        "video_rife_status",
        "video_rife_preview_plan",
        "video_rife_preview_run",
        "video_rife_preview_resume",
        "video_rife_preview_status",
        "video_caption_preview_plan",
        "video_caption_preview_run",
        "video_caption_preview_resume",
        "video_caption_preview_status",
        "video_caption_delivery_plan",
        "video_caption_delivery_run",
        "video_caption_delivery_resume",
        "video_caption_delivery_status",
        "delivery_preflight",
        "delivery_video_export_intent",
        "delivery_video_export_plan",
        "delivery_video_export_run",
        "delivery_video_export_resume",
        "delivery_video_export_status",
        "delivery_posting_plan",
        "delivery_package",
        "delivery_package_status",
        "delivery_post_upload_record",
        "delivery_post_upload_inspect",
        "delivery_audio_export_plan",
        "delivery_audio_export_run",
        "delivery_audio_export_resume",
        "delivery_audio_export_status",
        "delivery_evidence_plan",
        "delivery_evidence_seal",
        "delivery_evidence_verify",
        "delivery_evidence_record_verification",
        "video_lyrics_prepare_request",
        "video_lyrics_initialize",
        "video_lyrics_import",
        "video_lyrics_status",
        "video_lyrics_review",
        "video_lyrics_export",
        "video_lyrics_attach",
        "video_metadata_remux_plan",
        "video_metadata_remux_run",
        "video_metadata_remux_resume",
        "video_metadata_remux_status",
        "timed_text_formats",
        "timed_text_convert",
        "plan",
        "plan_v3",
        "run",
        "run_v3",
        "resume",
        "resume_v3",
        "status",
        "status_v3",
        "segment_plan",
        "segment_run",
        "segment_resume",
        "segment_reconstruct",
        "cache_inspect",
        "cache_invalidate",
        "cache_prune",
        "video_finishing_plan",
        "video_finishing_run",
        "video_finishing_resume",
        "video_finishing_status",
        "video_finishing_next_action",
        "video_finishing_record_review",
        "video_historical_import_review_plan",
        "video_historical_import_plan",
        "video_historical_import_run",
        "video_historical_import_resume",
        "video_historical_import_status",
        "delivery_audio_qc_plan",
        "delivery_audio_qc_run",
        "delivery_audio_qc_status",
        "delivery_publishing_plan",
        "delivery_publishing_run",
        "delivery_publishing_resume",
        "delivery_publishing_status",
        "delivery_publishing_next_action",
        "delivery_publishing_record_review",
        "video_spatial_carrier_inspect",
        "video_spatial_carrier_plan",
        "video_spatial_carrier_create",
        "video_spatial_carrier_status",
        "video_recovered_plan",
        "video_recovered_run",
        "video_recovered_resume",
        "video_recovered_status",
        "toolchain_prepare_publishing",
        "delivery_lossless_qc_plan",
        "delivery_lossless_qc_run",
        "delivery_lossless_qc_status",
        "delivery_audio_publishing_plan",
        "delivery_audio_publishing_run",
        "delivery_audio_publishing_resume",
        "delivery_audio_publishing_status",
        "delivery_audio_publishing_next_action",
        "delivery_audio_publishing_record_review",
        "toolchain_prepare_core"
      ]
    },
    "status": {
      "enum": [
        "success",
        "error"
      ]
    },
    "result": true,
    "error": {
      "type": "object",
      "required": [
        "category",
        "message"
      ],
      "properties": {
        "category": {
          "enum": [
            "input",
            "configuration",
            "dependency",
            "media",
            "execution",
            "state",
            "io",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "temporal": {
          "$ref": "#/$defs/diagnostic"
        },
        "validation": {
          "$ref": "validation-diagnostic-v1.schema.json"
        },
        "cache": {
          "$ref": "cache-diagnostic-v1.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "success"
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stream_index",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_rational",
            "arithmetic_overflow",
            "malformed_probe",
            "duplicate_stream",
            "missing_video",
            "ambiguous_video",
            "ambiguous_audio",
            "invalid_selection",
            "unacknowledged_stream",
            "missing_timestamp",
            "invalid_duration",
            "presentation_order",
            "decode_order",
            "missing_temporal_evidence",
            "variable_frame_rate",
            "nonzero_presentation_offset",
            "negative_presentation_offset",
            "stream_duration_mismatch",
            "synchronization_mismatch",
            "frame_count_mismatch",
            "timeline_mismatch",
            "unsupported_stream",
            "probe_limit",
            "source_changed",
            "legacy_temporal_evidence"
          ]
        },
        "stream_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
