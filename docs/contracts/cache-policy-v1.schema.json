{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/cache-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "owner",
    "maximum_bytes",
    "maximum_entries",
    "maximum_entry_bytes",
    "maximum_entry_files",
    "maximum_age_seconds",
    "minimum_free_bytes",
    "maximum_prune_entries"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.cache-policy/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 128
    },
    "maximum_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "maximum_entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "maximum_entry_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 18446744073709551615
    },
    "maximum_entry_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maximum_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 315360000
    },
    "minimum_free_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "maximum_prune_entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  }
}
