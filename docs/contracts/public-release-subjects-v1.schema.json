{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"aniflow.public-release-subjects/v1",
  "description":"Explicit allowlist projection of declared public subject identities and public-to-public lineage only. No native paths, private evidence, manifest/request digest or publication permission.",
