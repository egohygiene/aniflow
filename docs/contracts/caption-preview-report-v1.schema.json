{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.caption-preview-report/v1",
  "$comment": "Authored, uncompiled and unvalidated. Rust rechecks current exact source/reviews/inputs/implementation and native v3 acceptance. No implicit creative approval or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "provider_lock_sha256",
    "context_sha256",
    "subject_sha256",
    "frames",
    "review_scope",
    "native_qualified",
    "creative_approval"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.caption-preview-report/v1"
    },
    "operation": {
      "$ref": "caption-operation-v1.schema.json"
    },
    "provider_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "time",
          "filename",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "time": {
            "$ref": "temporal-inspection-v1.schema.json#/$defs/rational"
          },
          "filename": {
            "type": "string",
            "pattern": "^preview-[0-9]{4}\\.png$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          }
        }
      }
    },
    "review_scope": {
      "const": "selected_frames_only; soft_mux_player_typography_not_qualified; full_delivery_review_remains_separate"
    },
    "native_qualified": {
      "const": false
    },
    "creative_approval": {
      "const": "not_performed"
    }
  }
}
