{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/acceptance-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "semantics",
    "layer",
    "scope_id",
    "plan_sha256",
    "inputs",
    "artifacts",
    "validations",
    "children"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.acceptance-record/v1"
    },
    "semantics": {
      "const": "aniflow.layered-acceptance/v1"
    },
    "layer": {
      "enum": [
        "component",
        "stage",
        "candidate_master",
        "delivery"
      ]
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_invocation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "stage-checkpoint-v1.schema.json#/$defs/artifactEvidence"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "stage-checkpoint-v1.schema.json#/$defs/artifactEvidence"
      }
    },
    "validations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "stage-checkpoint-v1.schema.json#/$defs/validationEvidence"
      }
    },
    "children": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "stage-checkpoint-v1.schema.json#/$defs/evidenceReference"
      }
    }
  }
}
