{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-policy-assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "subject",
    "evaluation",
    "assessment_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-policy-assessment/v1"
    },
    "request": {
      "$ref": "audio-policy-check-request-v1.schema.json"
    },
    "subject": {
      "$ref": "destination-preflight-v1.schema.json#/$defs/media"
    },
    "evaluation": {
      "$ref": "audio-policy-evaluation-v1.schema.json"
    },
    "assessment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
