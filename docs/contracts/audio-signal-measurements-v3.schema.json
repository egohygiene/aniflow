{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/audio-signal-measurements-v3.schema.json",
  "title": "aniflow native PCM sample statistics evidence v3",
  "description": "Native PCM16/PCM24/float32 sample peak, RMS, crest factor and threshold regions. Float32 values above full scale remain measurable without integer quantization; nonfinite samples are refused by the reader. Loudness, true peak and short-term loudness are explicitly unavailable in this native-only profile. Source format, sample-grid arithmetic, ordered evidence, ratios and logarithmic relationships are validated by Rust against source evidence. JSON Schema structural success alone never proves execution, validity of the source bytes or pipeline completion. Historical v1/v2 PCM16 methods remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "technical_artifact",
    "inspection_analysis_artifact",
    "provider",
    "implementation_sha256",
    "configuration_sha256",
    "provider_lock_sha256",
    "tools",
    "settings",
    "source_format",
    "method",
    "commands",
    "channels",
    "integrated_loudness",
    "loudness_range",
    "true_peak",
    "short_term_status",
    "silence_regions",
    "clipping_regions"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-signal-measurements/v3"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "technical_artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "properties": {
            "id": {
              "const": "technical"
            },
            "byte_size": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "inspection_analysis_artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "properties": {
            "id": {
              "const": "analysis"
            }
          }
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-signal"
        },
        "version": {
          "const": "3.0.0"
        }
      }
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/toolObservation"
            },
            {
              "properties": {
                "id": {
                  "const": "ffmpeg"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/toolObservation"
            },
            {
              "properties": {
                "id": {
                  "const": "ffprobe"
                }
              }
            }
          ]
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "commands": {
      "type": "array",
      "maxItems": 0,
      "description": "Native sample statistics launch no additional analysis subprocesses; inspection commands remain in the bound technical artifact."
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "integrated_loudness": {
      "allOf": [
        {
          "$ref": "#/$defs/unavailableMeasurement"
        },
        {
          "properties": {
            "unit": {
              "const": "loudness_units_full_scale"
            }
          }
        }
      ]
    },
    "loudness_range": {
      "allOf": [
        {
          "$ref": "#/$defs/unavailableMeasurement"
        },
        {
          "properties": {
            "unit": {
              "const": "loudness_units"
            }
          }
        }
      ]
    },
    "true_peak": {
      "allOf": [
        {
          "$ref": "#/$defs/unavailableMeasurement"
        },
        {
          "properties": {
            "unit": {
              "const": "decibels_true_peak"
            }
          }
        }
      ]
    },
    "short_term_status": {
      "$ref": "#/$defs/nativeUnavailable"
    },
    "silence_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "clipping_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "source_format": {
      "enum": [
        "pcm16",
        "pcm24",
        "float32"
      ]
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "byte_size"
          ],
          "properties": {
            "id": {
              "const": "source_audio"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 44,
              "maximum": 268435456
            }
          }
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "const": 0
            },
            "denominator": {
              "const": 1
            }
          }
        },
        "stem": {
          "type": "null"
        }
      }
    },
    "toolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "stem_id": {
          "type": "null"
        }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 115199999
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "sample_peak_ratio",
        "rms_ratio",
        "sample_peak",
        "rms",
        "crest_factor"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sample_peak_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "rms_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "sample_peak": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels_full_scale"
                }
              }
            }
          ]
        },
        "rms": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels_full_scale"
                }
              }
            }
          ]
        },
        "crest_factor": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels"
                }
              }
            }
          ]
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "range"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "range": {
          "$ref": "#/$defs/frameRange"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "silence_threshold_ratio",
        "minimum_silence_milliseconds",
        "clipping_threshold_ratio"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-signal.configuration/v2"
        },
        "silence_threshold_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.0009765625
        },
        "minimum_silence_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 100
        },
        "clipping_threshold_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "full_scale_reference",
        "accumulation"
      ],
      "properties": {
        "algorithm": {
          "const": "aniflow.native-sample-statistics/v1"
        },
        "full_scale_reference": {
          "enum": [
            32768,
            8388608,
            1
          ]
        },
        "accumulation": {
          "const": "compensated_f64_sum_of_squares"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scope",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "decibels_full_scale",
            "decibels"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "measured"
                },
                "value": {
                  "type": "number",
                  "minimum": -1200,
                  "maximum": 1200
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "reason"
              ],
              "properties": {
                "kind": {
                  "const": "unavailable"
                },
                "reason": {
                  "const": "silent_input"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "decibels"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nativeUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "const": "unsupported_native_signal_profile"
        }
      }
    },
    "unavailableMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scope",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "loudness_units_full_scale",
            "loudness_units",
            "decibels_true_peak"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "value": {
          "$ref": "#/$defs/nativeUnavailable"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_format": {
            "const": "pcm16"
          }
        },
        "required": [
          "source_format"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "properties": {
              "full_scale_reference": {
                "const": 32768
              }
            }
          },
          "channels": {
            "items": {
              "properties": {
                "sample_peak_ratio": {
                  "maximum": 1
                },
                "rms_ratio": {
                  "maximum": 1
                },
                "sample_peak": {
                  "properties": {
                    "value": {
                      "properties": {
                        "value": {
                          "maximum": 0
                        }
                      }
                    }
                  }
                },
                "rms": {
                  "properties": {
                    "value": {
                      "properties": {
                        "value": {
                          "maximum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_format": {
            "const": "pcm24"
          }
        },
        "required": [
          "source_format"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "properties": {
              "full_scale_reference": {
                "const": 8388608
              }
            }
          },
          "channels": {
            "items": {
              "properties": {
                "sample_peak_ratio": {
                  "maximum": 1
                },
                "rms_ratio": {
                  "maximum": 1
                },
                "sample_peak": {
                  "properties": {
                    "value": {
                      "properties": {
                        "value": {
                          "maximum": 0
                        }
                      }
                    }
                  }
                },
                "rms": {
                  "properties": {
                    "value": {
                      "properties": {
                        "value": {
                          "maximum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_format": {
            "const": "float32"
          }
        },
        "required": [
          "source_format"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "properties": {
              "full_scale_reference": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ]
}
