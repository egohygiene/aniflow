{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.reviewed-lyrics-rendering/v1",
  "$comment": "Authored, uncompiled and unvalidated. Rust rechecks current exact source/reviews/inputs/implementation and native v3 acceptance. No implicit creative approval or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "delivery",
    "document",
    "srt_file",
    "srt_sha256",
    "srt_byte_count"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.reviewed-lyrics-rendering/v1"
    },
    "delivery": {
      "$ref": "recipe-lyrics-attachment-v1.schema.json#/properties/delivery"
    },
    "document": {
      "$ref": "timed-text-v1.schema.json"
    },
    "srt_file": {
      "type": "string",
      "minLength": 1
    },
    "srt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "srt_byte_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    }
  }
}
