{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.amv-advisory/v1",
  "$comment": "Authored/unvalidated. Current native acceptance and exact citations remain Rust checks; no model/media review or semantic grounding is established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "advisory_sha256",
    "packet_sha256",
    "candidate_sha256",
    "declared_identity",
    "observed_record_facts",
    "suggestions",
    "questions",
    "omissions",
    "semantic_grounding",
    "input_kind",
    "media_samples",
    "full_movie_reviewed",
    "technical_acceptance_authority",
    "provider_execution_observed",
    "creative_approval",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.amv-advisory/v1"
    },
    "advisory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "declared_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "runtime_revision",
        "profile_sha256",
        "template_sha256",
        "output_schema_sha256"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observed_record_facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "record_sha256",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "count"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "width",
                  "height"
                ],
                "properties": {
                  "kind": {
                    "const": "geometry"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "rational"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "properties": {
                      "numerator": {
                        "type": "integer"
                      },
                      "denominator": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "interval"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer"
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      "end": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer"
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "flag"
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "final_frame_ordinal",
                "final_pts"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "final_frame_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "final_pts": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer"
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "final_frame_ordinal",
                "final_pts"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "final_frame_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "final_pts": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer"
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "semantic_grounding": {
      "const": "citation_membership_and_exact_fact_projection_only; suggestion_meaning_unverified"
    },
    "input_kind": {
      "const": "supplied_untrusted_candidate; no_provider_invocation"
    },
    "media_samples": {
      "const": 0
    },
    "full_movie_reviewed": {
      "const": false
    },
    "technical_acceptance_authority": {
      "const": false
    },
    "provider_execution_observed": {
      "const": false
    },
    "creative_approval": {
      "const": "not_performed"
    },
    "publication_authority": {
      "const": "none"
    }
  }
}
