{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "initial_selection",
    "missing_inputs",
    "batches",
    "components",
    "first_native_plan",
    "projected_working_bytes",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.recovered-music-video-intent/v1"
    },
    "request": {
      "$ref": "recovered-music-video-request-v1.schema.json"
    },
    "initial_selection": {
      "$ref": "spatial-selection-plan-v1.schema.json"
    },
    "missing_inputs": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "byte_count"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824
          }
        }
      }
    },
    "first_native_plan": {
      "anyOf": [
        {
          "$ref": "pipeline-v3-plan-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "projected_working_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 17592186044416
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.recovered-music-video-intent/v1",
  "description": "PRIVATE fixed recovered spatial continuation. Rust binds exact current source/index, selected native/import checkpoints, missing input identities, tool/model settings and actual native child plans. Existing v3 acceptance remains authoritative. No partial adoption, automatic quality approval or publication. Authored, unvalidated; execution deferred to flow #88."
}
