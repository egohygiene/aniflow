{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.chunked-recovered-rife-status/v1",
  "$comment": "Authored/unvalidated. Exact current native producers, PNGs, clocks, pins, admission and complete-set acceptance remain Rust owner checks. No native or creative qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_directory",
    "native_run_directory",
    "intent_sha256",
    "completed_chunks",
    "pending_chunks",
    "failed_chunks",
    "complete",
    "native"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.chunked-recovered-rife-status/v1"
    },
    "run_directory": {
      "type": "string"
    },
    "native_run_directory": {
      "type": "string"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completed_chunks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "pending_chunks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "failed_chunks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "complete": {
      "type": "boolean"
    },
    "native": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "$comment": "Actual PipelineV3RunManifest is governed and validated by the existing native v3 owner; this projection does not establish acceptance.",
          "additionalProperties": false,
          "required": [
            "schema",
            "algorithm",
            "canonicalization",
            "manifest_sha256",
            "payload"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "algorithm": {
              "type": "string"
            },
            "canonicalization": {
              "type": "string"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
