    "delivery":{"type":"object","description":"Existing ManualLyricsDelivery projection. Rust rechecks its request/reviews, exact exports, digests, losses and carrier omissions; no mux or render approval is inferred.","required":["schema","request_sha256","input_sha256","audio","timeline_sha256","offset","delivery_extent","words_review_sha256","timing_review_sha256","exports","render_review","runtime_qualified"],"properties":{"schema":{"const":"aniflow.manual-lyrics-delivery/v1"},"runtime_qualified":{"const":false},"exports":{"type":"array","minItems":1,"maxItems":6}}}
