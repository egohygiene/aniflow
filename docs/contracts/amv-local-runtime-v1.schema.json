{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.amv-local-runtime/v1",
  "$comment": "Authored/unvalidated source contract; native/backend qualification is deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "enabled",
    "python_executable",
    "endpoint",
    "runtime_version",
    "model_name",
    "model_sha256",
    "service_egress_disabled_declared",
    "context_tokens",
    "output_tokens",
    "timeout_milliseconds"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.amv-local-runtime/v1"
    },
    "enabled": {
      "type": "boolean"
    },
    "python_executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "endpoint": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9._+-]+$"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "service_egress_disabled_declared": {
      "const": true
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 512,
      "maximum": 32768
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "timeout_milliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  }
}
