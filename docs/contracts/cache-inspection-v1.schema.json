{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/cache-inspection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "owner",
    "exists",
    "writer_present",
    "entries",
    "temporary_entries",
    "byte_count"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.cache-inspection/v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "exists": {
      "type": "boolean"
    },
    "writer_present": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_sha256",
          "state",
          "byte_count",
          "created_at",
          "diagnostic"
        ],
        "properties": {
          "key_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "available",
              "expired",
              "invalid"
            ]
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostic": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 4096
    },
    "temporary_entries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
