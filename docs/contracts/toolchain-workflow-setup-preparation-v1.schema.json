{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-workflow-setup-preparation-v1.schema.json",
  "title": "toolchain-workflow-setup-preparation-v1",
  "required": [
    "schema",
    "request_sha256",
    "ready",
    "selections",
    "diagnostics",
    "native_qualification",
    "host_runtime_evidence",
    "source_media_evidence",
    "provider_evidence",
    "publication_authority",
    "omitted_roles",
    "execution_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.toolchain.workflow-setup-preparation/v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ready": {
      "type": "boolean"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "capability_id",
          "selection",
          "preparation"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "selection": {
            "$ref": "toolchain-media-setup-v1.schema.json#/properties/selection"
          },
          "preparation": {
            "$ref": "toolchain-media-setup-preparation-v1.schema.json"
          },
          "role": {
            "enum": [
              "frame_extraction",
              "image_repair",
              "upscale",
              "interpolation",
              "clean_video_assembly",
              "caption_rendering",
              "metadata_remux",
              "destination_video",
              "lossless_audio_export",
              "final_video_audio_qc",
              "final_lossless_audio_qc"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_qualification": {
      "const": false
    },
    "host_runtime_evidence": {
      "const": "unobserved"
    },
    "source_media_evidence": {
      "const": "unobserved"
    },
    "provider_evidence": {
      "const": "unobserved; actual domain planning/execution supplies native identity"
    },
    "publication_authority": {
      "const": "none"
    },
    "omitted_roles": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frame_extraction",
          "image_repair",
          "upscale",
          "interpolation",
          "clean_video_assembly",
          "caption_rendering",
          "metadata_remux",
          "destination_video",
          "lossless_audio_export",
          "final_video_audio_qc",
          "final_lossless_audio_qc"
        ]
      }
    },
    "execution_authority": {
      "const": "none; selection order is not a runtime plan"
    }
  },
  "$comment": "Current selected core extraction/master-delivery prerequisite projection only; no media/process/model/configuration write/installation or inferred execution/qualification. Exact roles, settings, distinct domain kinds, one/eight MiB bounds and identity relationships enforced by Rust. Existing publishing scope stays separate.",
  "description": "Closed bounded inert preparation over only explicit domain roles. No media/process/model-discovery/install/registration/write or native qualification. Authored, unvalidated."
}
