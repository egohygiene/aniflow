{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.video-assembly-report/v1",
  "title": "aniflow observed frame assembly report v1",
  "description": "Contemporary source, frame-index, tool and output observations for one fixed Pipeline v3 assembly stage. Native execution checks the entire output, exact rational frame timeline, geometry, selected AAC-LC packets and priming, full decode and MP4 faststart atoms. The master additionally checks every decoded RGB24 frame against the indexed PNG sequence. A lossy delivery has no lossless pixel claim. These records do not prove imported frame history, visual quality, general backend qualification or checkpoint acceptance; immutable runtime validation remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "stage_id", "provider_lock_sha256", "configuration_sha256", "source_sha256", "source_byte_count", "frame_index_sha256", "index_schema", "frame_count", "width", "height", "output_sha256", "output_byte_count", "ffmpeg", "ffprobe", "source_relationship", "historical_processing", "backend_qualification", "media"],
  "properties": {
    "schema": { "const": "aniflow.video-assembly-report/v1" },
    "stage": { "enum": ["master", "delivery"] },
    "stage_id": { "enum": ["assemble_master", "encode_delivery"] },
    "provider_lock_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_byte_count": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "frame_index_sha256": { "$ref": "#/$defs/sha256" },
    "index_schema": { "enum": ["aniflow.rife-frame-index/v1", "aniflow.upscayl-output-index/v1"] },
    "frame_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "width": { "type": "integer", "minimum": 2, "maximum": 4294967295, "multipleOf": 2 },
    "height": { "type": "integer", "minimum": 2, "maximum": 4294967295, "multipleOf": 2 },
    "output_sha256": { "$ref": "#/$defs/sha256" },
    "output_byte_count": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "ffmpeg": { "allOf": [{ "$ref": "#/$defs/tool" }, { "properties": { "id": { "const": "ffmpeg" } } }] },
    "ffprobe": { "allOf": [{ "$ref": "#/$defs/tool" }, { "properties": { "id": { "const": "ffprobe" } } }] },
    "source_relationship": { "const": "declared_not_verified" },
    "historical_processing": { "const": "unknown" },
    "backend_qualification": { "const": "invocation_observed_not_backend_qualified" },
    "media": { "$ref": "#/$defs/media" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "master" } } },
      "then": { "properties": { "stage_id": { "const": "assemble_master" }, "media": { "properties": { "kind": { "const": "master" } } } } },
      "else": { "properties": { "stage_id": { "const": "encode_delivery" }, "media": { "properties": { "kind": { "const": "delivery" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "not": { "pattern": "[\\x00-\\x1f\\x7f-\\x9f]" } },
    "nullable_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "enum": ["ffmpeg", "ffprobe"] },
        "version": { "const": "8.0.1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "kind", "method", "temporal_inspection", "source_audio_sha256", "output_audio_sha256", "decoded_rgb24_sha256", "frame_count", "width", "height", "video_codec", "pixel_format", "faststart", "native_qualified"],
      "properties": {
        "profile": { "const": "aniflow.ffmpeg-8.0.1-rgb8-cfr-aac-assembly/v1" },
        "kind": { "enum": ["master", "delivery"] },
        "method": { "const": "native_integer_timeline_rgb24_framehash_aac_packet_sha256_mp4_atoms" },
        "temporal_inspection": { "$ref": "temporal-inspection-v1.schema.json" },
        "source_audio_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "output_audio_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "decoded_rgb24_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "frame_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "width": { "type": "integer", "minimum": 2, "maximum": 4294967295, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 2, "maximum": 4294967295, "multipleOf": 2 },
        "video_codec": { "enum": ["ffv1", "h264"] },
        "pixel_format": { "enum": ["bgr0", "yuv420p"] },
        "faststart": { "const": true },
        "native_qualified": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "master" } } },
          "then": { "properties": { "video_codec": { "const": "ffv1" }, "pixel_format": { "const": "bgr0" }, "decoded_rgb24_sha256": { "$ref": "#/$defs/sha256" } } },
          "else": { "properties": { "video_codec": { "const": "h264" }, "pixel_format": { "const": "yuv420p" }, "decoded_rgb24_sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "source_audio_sha256": { "type": "null" } } },
          "then": { "properties": { "output_audio_sha256": { "type": "null" } } },
          "else": { "properties": { "output_audio_sha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    }
  }
}
