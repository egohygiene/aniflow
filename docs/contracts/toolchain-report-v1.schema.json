{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-report-v1.schema.json",
  "title": "aniflow toolchain report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aniflow.toolchain-report/v1"
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 64
    },
    "ready": {
      "type": "boolean"
    },
    "native_qualification": {
      "const": false
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "required": [
    "schema",
    "profile_id",
    "profile_sha256",
    "inventory_sha256",
    "selected_capabilities",
    "ready",
    "native_qualification",
    "facts",
    "actions"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/id"
        },
        "dependency_id": {
          "$ref": "#/$defs/id"
        },
        "check": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "installed",
            "missing",
            "incompatible",
            "unverified"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "capability_id",
        "check",
        "status",
        "detail"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/id"
        },
        "dependency_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/text"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "suggested_locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "required": [
        "capability_id",
        "kind",
        "detail",
        "suggested_locators"
      ]
    }
  }
}
