{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.release-evidence-handoff-request/v1",
  "$comment": "Authored/unvalidated. Exact public field projection only; hashes/OTS subject relationships do not authenticate identity, Bitcoin time, current producers or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_directory",
    "manifest_sha256",
    "subjects",
    "maximum_archive_subject_bytes",
    "maximum_proof_bytes",
    "minimum_free_bytes"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.release-evidence-handoff-request/v1"
    },
    "bundle_directory": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "proof": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directory",
                  "receipt_sha256"
                ],
                "properties": {
                  "directory": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 4096
                  },
                  "receipt_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "maximum_archive_subject_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    },
    "maximum_proof_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "minimum_free_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    }
  }
}
