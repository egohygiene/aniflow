{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/provider-event-v1.schema.json",
  "title": "aniflow provider lifecycle event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "observed_at",
    "provider_lock_sha256",
    "kind"
  ],
  "properties": {
    "schema": { "const": "aniflow.provider-event/v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "provider_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "execution_started",
        "cancellation_observed",
        "timeout_exceeded",
        "capture_limit_exceeded",
        "artifact_limit_exceeded",
        "process_exited",
        "output_validation_started",
        "output_validated",
        "execution_succeeded",
        "execution_failed"
      ]
    }
  }
}
