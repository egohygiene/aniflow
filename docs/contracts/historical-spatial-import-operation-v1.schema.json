{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.historical-spatial-import-operation/v1",
  "description": "Current selected-frame validation and an exact supplied import decision; never native Upscayl replay or complete-set assembly authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent",
    "declaration"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.historical-spatial-import-operation/v1"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "source_sha256",
        "source_bytes",
        "source_index_sha256",
        "source_index_bytes",
        "source_width",
        "source_height",
        "original_frame_count",
        "frames"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decoder",
            "output_width",
            "output_height",
            "minimum_free_bytes"
          ],
          "properties": {
            "decoder": {
              "$ref": "../../providers/frame-import/configuration.schema.json"
            },
            "output_width": {
              "type": "integer",
              "minimum": 2
            },
            "output_height": {
              "type": "integer",
              "minimum": 2
            },
            "minimum_free_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_index_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_width": {
          "type": "integer",
          "minimum": 1
        },
        "source_height": {
          "type": "integer",
          "minimum": 1
        },
        "original_frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "filename",
              "sha256",
              "byte_count",
              "source_time"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "filename": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*[.]png$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_time": {
                "type": "object",
                "description": "Exact original RationalTime start/end; native owner validates it against the original selected index."
              }
            }
          }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "context_sha256",
        "subject_sha256",
        "decision",
        "reviewer",
        "notes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.manual-review/v1"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "const": "approve"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
