{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.chunked-recovered-rife-intent/v1",
  "$comment": "Authored/unvalidated. Exact current native producers, PNGs, clocks, pins, admission and complete-set acceptance remain Rust owner checks. No native or creative qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "native_plan",
    "intent_sha256"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.chunked-recovered-rife-intent/v1"
    },
    "request": {
      "$ref": "chunked-recovered-rife-request-v1.schema.json"
    },
    "native_plan": {
      "$ref": "pipeline-v3-plan-v1.schema.json"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
