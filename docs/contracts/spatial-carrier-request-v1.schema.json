{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_video",
    "source_index",
    "sources",
    "output_width",
    "output_height",
    "maximum_source_bytes",
    "maximum_frame_bytes",
    "maximum_total_frame_bytes",
    "maximum_working_bytes",
    "minimum_free_bytes"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.spatial-carrier-request/v1"
    },
    "source_video": {
      "type": "string",
      "minLength": 1
    },
    "source_index": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "run_directory",
              "ordinals"
            ],
            "properties": {
              "kind": {
                "const": "historical"
              },
              "run_directory": {
                "type": "string",
                "minLength": 1
              },
              "ordinals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99999
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "run_directory",
              "configuration",
              "units"
            ],
            "properties": {
              "kind": {
                "const": "native"
              },
              "run_directory": {
                "type": "string",
                "minLength": 1
              },
              "configuration": {
                "$ref": "../../providers/upscayl-recovery/configuration.schema.json"
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "stage_id",
                    "ordinals"
                  ],
                  "properties": {
                    "stage_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ordinals": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99999
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "output_width": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16384,
      "multipleOf": 2
    },
    "output_height": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16384,
      "multipleOf": 2
    },
    "maximum_source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    },
    "maximum_frame_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 268435456
    },
    "maximum_total_frame_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1099511627776
    },
    "maximum_working_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 17592186044416
    },
    "minimum_free_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.spatial-carrier-request/v1",
  "description": "PRIVATE explicit accepted spatial composition. Rust additionally requires current native/import checkpoint authority, original source/index/clock, full unique coverage for publication, uniform geometry and exact copied bytes. Shape alone grants no acceptance, history, quality, or qualification. Authored, unvalidated."
}
