{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.release-stages-entry-status/v1",
  "$comment": "Authored/unvalidated. Existing native recipe/review/final-video owners remain authoritative; this projection executes no media operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_sha256",
    "entry_kind",
    "recipe_intent_sha256",
    "configuration_sha256",
    "initial_inputs",
    "phases",
    "state",
    "next_action",
    "prepared_frames",
    "recipe_complete",
    "master",
    "release",
    "release_observed",
    "native_execution_authority",
    "creative_approval",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.release-stages-entry-status/v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry_kind": {
      "enum": [
        "indexed",
        "source"
      ]
    },
    "recipe_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initial_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_type",
          "artifact_role",
          "kind",
          "file_count",
          "byte_count",
          "content_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "artifact_role": {
            "enum": [
              "temporal_source",
              "temporal_component",
              "intermediate",
              "candidate_master",
              "validated_master",
              "validation_evidence",
              "run_evidence",
              "delivery_receipt"
            ]
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stream_role": {
            "enum": [
              "video",
              "audio",
              "subtitle",
              "transcript",
              "timed_metadata",
              "attachment"
            ]
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "state",
          "run_directory",
          "plan_sha256",
          "native_manifest_sha256"
        ],
        "properties": {
          "phase": {
            "enum": [
              "extract_frames",
              "prepare_frames",
              "upscale",
              "interpolate",
              "assembly"
            ]
          },
          "state": {
            "enum": [
              "disabled",
              "already_target",
              "above_target",
              "pending",
              "ready",
              "running",
              "complete",
              "failed",
              "cancelled",
              "incomplete_initialization",
              "awaiting_input",
              "awaiting_review"
            ]
          },
          "run_directory": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^/",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_manifest_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "state": {
      "enum": [
        "pending",
        "ready",
        "running",
        "awaiting_input",
        "awaiting_review",
        "rejected",
        "invalidated",
        "incomplete",
        "failed",
        "cancelled",
        "master_accepted",
        "release_pending",
        "release_complete"
      ]
    },
    "next_action": {
      "enum": [
        "resume_existing_recipe",
        "inspect_native_recovery",
        "supply_prepared_frame_decision",
        "start_new_context",
        "configure_release_tail",
        "inspect_release_tail",
        "none"
      ]
    },
    "prepared_frames": {
      "anyOf": [
        {
          "$ref": "prepared-frame-review-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe_complete": {
      "type": "boolean"
    },
    "master": {
      "anyOf": [
        {
          "$ref": "final-video-handoff-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "release": {
      "anyOf": [
        {
          "$ref": "release-stages-status-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_observed": {
      "type": "boolean"
    },
    "native_execution_authority": {
      "const": "none; use existing recipe run/resume explicitly"
    },
    "creative_approval": {
      "const": "only retained exact operator declarations; no new creative approval"
    },
    "publication_authority": {
      "const": "none"
    }
  }
}
