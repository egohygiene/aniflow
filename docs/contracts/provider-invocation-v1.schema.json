{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/provider-invocation-v1.schema.json",
  "title": "aniflow provider invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_semantics",
    "stage_id",
    "provider_lock_sha256",
    "configuration",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schema": { "const": "aniflow.provider-invocation/v1" },
    "execution_semantics": {
      "const": "aniflow.provider-invocation/direct-argv/v1"
    },
    "stage_id": { "$ref": "#/$defs/localId" },
    "provider_lock_sha256": { "$ref": "#/$defs/sha256" },
    "configuration": { "$ref": "#/$defs/providerConfiguration" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactBinding" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactBinding" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001F\\u007F-\\u009F]*$",
      "not": {
        "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)"
      }
    },
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "configurationSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*/v[1-9][0-9]*$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "providerConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider",
        "capability",
        "configuration_schema",
        "values",
        "effective_configuration_sha256"
      ],
      "properties": {
        "schema": { "const": "aniflow.provider-configuration/v1" },
        "provider": { "$ref": "#/$defs/providerReference" },
        "capability": { "$ref": "#/$defs/capabilityReference" },
        "configuration_schema": { "$ref": "#/$defs/configurationSchema" },
        "values": { "type": "object" },
        "effective_configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "artifact_id",
        "artifact_type",
        "artifact_role",
        "kind",
        "path"
      ],
      "properties": {
        "port": { "$ref": "#/$defs/localId" },
        "artifact_id": { "$ref": "#/$defs/localId" },
        "artifact_type": { "$ref": "#/$defs/artifactType" },
        "artifact_role": {
          "enum": [
            "temporal_source",
            "temporal_component",
            "intermediate",
            "candidate_master",
            "validated_master",
            "validation_evidence",
            "run_evidence",
            "delivery_receipt"
          ]
        },
        "stream_role": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "transcript",
            "timed_metadata",
            "attachment"
          ]
        },
        "kind": { "enum": ["file", "directory"] },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    }
  }
}
