{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/audio-technical-inspection-v1.schema.json",
  "title": "aniflow bounded PCM16 technical inspection evidence v1",
  "description": "Complete provider-authored evidence over immutable PCM16 RIFF/WAV input. Structural validation does not inspect media, establish completion, or replace the public Rust checks for rational duration, PCM bitrate, matching decode/source identities. Pipeline v3 retains its independent artifact-integrity completion gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "provider",
    "implementation_sha256",
    "configuration_sha256",
    "provider_lock_sha256",
    "tools",
    "container",
    "codec",
    "sample_format",
    "stream_index",
    "sample_rate_hz",
    "channels",
    "frame_count",
    "duration",
    "pcm_bitrate_bits_per_second",
    "pcm_sha256",
    "decoded_pcm_sha256",
    "decode_complete",
    "source_unchanged",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-technical-inspection/v1"
    },
    "source": {
      "$ref": "#/$defs/sourceArtifact"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-inspection"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "const": "ffmpeg"
            },
            "version": {
              "$ref": "#/$defs/semanticVersion"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "const": "ffprobe"
            },
            "version": {
              "$ref": "#/$defs/semanticVersion"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ],
      "items": false
    },
    "container": {
      "const": "wav"
    },
    "codec": {
      "const": "pcm_s16le"
    },
    "sample_format": {
      "const": "s16"
    },
    "stream_index": {
      "const": 0
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "channels": {
      "enum": [
        1,
        2
      ]
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 115200000
    },
    "duration": {
      "$ref": "#/$defs/duration"
    },
    "pcm_bitrate_bits_per_second": {
      "type": "integer",
      "minimum": 128000,
      "maximum": 6144000
    },
    "pcm_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decoded_pcm_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decode_complete": {
      "const": true
    },
    "source_unchanged": {
      "const": true
    },
    "commands": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments"
          ],
          "properties": {
            "tool": {
              "const": "ffprobe"
            },
            "arguments": {
              "type": "array",
              "const": [
                "-v",
                "error",
                "-protocol_whitelist",
                "file,pipe",
                "-show_entries",
                "stream=index,codec_type,codec_name,sample_fmt,sample_rate,channels,bits_per_sample,time_base,duration_ts,start_pts,bit_rate:format=format_name,nb_streams",
                "-of",
                "json",
                "-i",
                "{snapshot}"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments"
          ],
          "properties": {
            "tool": {
              "const": "ffmpeg"
            },
            "arguments": {
              "type": "array",
              "const": [
                "-v",
                "error",
                "-nostdin",
                "-xerror",
                "-err_detect",
                "explode",
                "-threads",
                "1",
                "-protocol_whitelist",
                "file,pipe",
                "-i",
                "{snapshot}",
                "-map",
                "0:a:0",
                "-vn",
                "-sn",
                "-dn",
                "-codec:a",
                "pcm_s16le",
                "-f",
                "hash",
                "-hash",
                "sha256",
                "pipe:1"
              ]
            }
          }
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 44,
          "maximum": 268435456
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 192000
        }
      }
    }
  }
}
