{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "provider_lock_sha256",
    "frames",
    "comparison_sha256",
    "visual_approval",
    "runtime_qualified",
    "audio_scope"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.deflicker-comparison-report/v1"
    },
    "operation": {
      "$ref": "deflicker-comparison-operation-v1.schema.json"
    },
    "provider_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original_ordinal",
          "source_time",
          "before_sha256",
          "before_bytes",
          "after_sha256",
          "after_bytes",
          "before_rgb_sha256",
          "after_rgb_sha256"
        ],
        "properties": {
          "original_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "source_time": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "integer"
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "before_rgb_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_rgb_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "comparison_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "visual_approval": {
      "const": "not_performed"
    },
    "runtime_qualified": {
      "const": false
    },
    "audio_scope": {
      "const": "silent_visual_excerpt; original_audio_unchanged_unassessed"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.deflicker-comparison-report/v1",
  "description": "Explicit short silent visual comparison, authored/unvalidated. Native v3 acceptance, supplied excerpt review and full-video publication remain separate. No perceptual/native qualification is inferred."
}
