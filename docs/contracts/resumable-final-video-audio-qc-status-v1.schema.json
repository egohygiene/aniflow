{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.resumable-final-video-audio-qc-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_directory",
    "intent_sha256",
    "phase",
    "native_plan_sha256",
    "native_manifest_sha256",
    "complete",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.resumable-final-video-audio-qc-status/v1"
    },
    "run_directory": {
      "type": "string",
      "minLength": 1
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "capture",
        "decode",
        "native_signal",
        "meter",
        "complete"
      ]
    },
    "native_plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "final-audio-qc-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "Process-free exact recognized-boundary/current-native projection; unknown or unmarked partial state is retained/refused. Authored, unvalidated. Shape grants no native acceptance, musical approval or publication authority."
}
