{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.detached-proof-candidate/v1",
  "$comment": "Authored/unvalidated. Exact opaque candidate bytes only; no cryptographic OTS verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_sha256",
    "manifest_sha256",
    "subject",
    "subject_sha256",
    "subject_bytes",
    "proof_sha256",
    "proof_bytes",
    "sequence",
    "previous_receipt_sha256",
    "previous_proof_sha256",
    "proof_format",
    "subject_binding",
    "timestamp_state",
    "ownership"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.detached-proof-candidate/v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "manifest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "subject"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          }
        }
      ]
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proof_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_proof_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_format": {
      "const": "opaque_opentimestamps_candidate; unparsed"
    },
    "subject_binding": {
      "const": "operator_declared; cryptographic_subject_binding_not_verified"
    },
    "timestamp_state": {
      "const": "not_verified"
    },
    "ownership": {
      "const": "not_established"
    }
  }
}
