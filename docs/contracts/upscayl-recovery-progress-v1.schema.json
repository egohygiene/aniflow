{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.upscayl-recovery-progress/v1",
  "$comment": "Authored/unvalidated source contract; qualification remains deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inventory",
    "timing",
    "native_qualified",
    "creative_approval"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.upscayl-recovery-progress/v1"
    },
    "inventory": {
      "$ref": "upscayl-recovery-inventory-v1.schema.json"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "measured_frames",
        "measured_provider_milliseconds",
        "remaining_frames",
        "estimated_remaining_milliseconds",
        "basis",
        "exclusions"
      ],
      "properties": {
        "samples": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "checkpoint_sha256",
              "execution_report_sha256",
              "frame_count",
              "provider_duration_milliseconds"
            ],
            "properties": {
              "stage_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "checkpoint_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_report_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "frame_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "provider_duration_milliseconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "measured_frames": {
          "type": "integer",
          "minimum": 0
        },
        "measured_provider_milliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_frames": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_remaining_milliseconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "const": "conditional serial work at the frame-weighted mean of completed provider durations; no deadline"
        },
        "exclusions": {
          "const": "collector, validation, retries, contention, active-unit elapsed time, future host changes and full-run completion are not estimated; zero/no measured duration yields unavailable"
        }
      }
    },
    "native_qualified": {
      "const": false
    },
    "creative_approval": {
      "const": "none"
    }
  }
}
