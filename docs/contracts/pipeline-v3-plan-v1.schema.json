{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/pipeline-v3-plan-v1.schema.json",
  "title": "aniflow deterministic Pipeline v3 resolved plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "canonicalization",
    "plan_sha256",
    "payload"
  ],
  "properties": {
    "schema": { "const": "aniflow.pipeline-plan/v1" },
    "algorithm": { "const": "sha256" },
    "canonicalization": { "const": "aniflow.canonical-json/v1" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "payload": { "$ref": "#/$defs/planPayload" }
  },
  "$defs": {
    "printableText": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "artifactType": {
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "artifactRole": {
      "enum": [
        "temporal_source",
        "temporal_component",
        "intermediate",
        "candidate_master",
        "validated_master",
        "validation_evidence",
        "run_evidence",
        "delivery_receipt"
      ]
    },
    "streamRole": {
      "enum": [
        "video",
        "audio",
        "subtitle",
        "transcript",
        "timed_metadata",
        "attachment"
      ]
    },
    "sideEffect": {
      "enum": [
        "filesystem_read",
        "filesystem_write",
        "environment_read",
        "subprocess",
        "network",
        "ai",
        "gpu",
        "publish"
      ]
    },
    "providerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_id"],
      "properties": {
        "registration_id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["replacement", "primary", "fallback"] },
        "fallback_index": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "fallback" } } },
          "then": { "required": ["fallback_index"] },
          "else": { "not": { "required": ["fallback_index"] } }
        }
      ]
    },
    "providerSelectionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallbacks"],
      "properties": {
        "replacement": { "$ref": "#/$defs/providerCandidate" },
        "primary": { "$ref": "#/$defs/providerCandidate" },
        "fallbacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerCandidate" }
        }
      }
    },
    "availabilityCode": {
      "enum": [
        "not_registered",
        "capability_mismatch",
        "version_mismatch",
        "executable_unavailable",
        "executable_not_regular_file",
        "executable_not_runnable",
        "component_missing",
        "component_version_mismatch",
        "component_digest_mismatch",
        "insufficient_cpu",
        "insufficient_memory",
        "insufficient_storage",
        "gpu_unavailable",
        "network_unavailable",
        "offline_incompatible",
        "side_effect_denied"
      ]
    },
    "plannedResolutionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "selection", "available", "reason_codes"],
      "properties": {
        "candidate": { "$ref": "#/$defs/providerCandidate" },
        "selection": { "$ref": "#/$defs/selection" },
        "available": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/availabilityCode" }
        }
      }
    },
    "providerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "configurationSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*/v[1-9][0-9]*$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executable_sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "providerLockPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_id",
        "provider",
        "capability",
        "configuration_schema",
        "effective_configuration_sha256",
        "manifest_sha256",
        "implementation",
        "tools",
        "codecs",
        "models",
        "authorized_side_effects",
        "selection",
        "offline"
      ],
      "properties": {
        "registration_id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "provider": { "$ref": "#/$defs/providerReference" },
        "capability": { "$ref": "#/$defs/capabilityReference" },
        "configuration_schema": { "$ref": "#/$defs/configurationSchema" },
        "effective_configuration_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "implementation": { "$ref": "#/$defs/implementation" },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "codecs": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "authorized_side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sideEffect" }
        },
        "selection": { "$ref": "#/$defs/selection" },
        "offline": { "type": "boolean" }
      }
    },
    "providerLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "lock_sha256", "payload"],
      "properties": {
        "schema": { "const": "aniflow.provider-lock/v1" },
        "algorithm": { "const": "sha256" },
        "lock_sha256": { "$ref": "#/$defs/sha256" },
        "payload": { "$ref": "#/$defs/providerLockPayload" }
      }
    },
    "artifactPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact_type",
        "artifact_role",
        "cardinality",
        "immutable"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/localId" },
        "artifact_type": { "$ref": "#/$defs/artifactType" },
        "artifact_role": { "$ref": "#/$defs/artifactRole" },
        "stream_role": { "$ref": "#/$defs/streamRole" },
        "cardinality": { "enum": ["one", "optional", "one_or_more", "many"] },
        "immutable": { "const": true }
      }
    },
    "componentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_requirement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "version_requirement": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "requirementLevel": {
      "enum": ["forbidden", "optional", "required"]
    },
    "computeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_cpu_threads",
        "minimum_memory_mib",
        "minimum_storage_mib",
        "gpu",
        "network"
      ],
      "properties": {
        "minimum_cpu_threads": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "minimum_memory_mib": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "minimum_storage_mib": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "gpu": { "$ref": "#/$defs/requirementLevel" },
        "network": { "$ref": "#/$defs/requirementLevel" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "codecs", "models", "compute"],
      "properties": {
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentRequirement" }
        },
        "codecs": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentRequirement" }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentRequirement" }
        },
        "compute": { "$ref": "#/$defs/computeRequirements" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "determinism",
        "fidelity",
        "cacheable",
        "content_changes",
        "side_effects"
      ],
      "properties": {
        "determinism": {
          "enum": [
            "deterministic",
            "configuration_dependent",
            "environment_dependent",
            "nondeterministic"
          ]
        },
        "fidelity": { "enum": ["lossless", "lossy", "observational", "not_applicable"] },
        "cacheable": { "type": "boolean" },
        "content_changes": { "type": "boolean" },
        "side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sideEffect" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress", "cancellation"],
      "properties": {
        "progress": { "enum": ["none", "lifecycle_events", "item_counts", "fractional"] },
        "cancellation": { "enum": ["unsupported", "cooperative", "process_signal"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "configuration_schema",
        "inputs",
        "outputs",
        "batching",
        "max_concurrency",
        "requirements",
        "behavior",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "kind": {
          "enum": [
            "frame_processor",
            "audio_processor",
            "timed_text_processor",
            "whole_video_processor",
            "stream_inspector",
            "temporal_validator",
            "artifact_validator",
            "assembler_encoder",
            "delivery_provider",
            "lifecycle_observer"
          ]
        },
        "configuration_schema": { "$ref": "#/$defs/configurationSchema" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactPort" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactPort" }
        },
        "batching": {
          "enum": ["none", "per_artifact", "directory_batch", "whole_artifact", "stream"]
        },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "requirements": { "$ref": "#/$defs/requirements" },
        "behavior": { "$ref": "#/$defs/behavior" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_requirement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aniflow/[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "version_requirement": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "artifacts"],
      "properties": {
        "port": { "$ref": "#/$defs/localId" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        }
      }
    },
    "plannedExpectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path", "artifact_type", "artifact_role"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:<>\\u0022|?*])(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))artifacts/[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "artifact_type": { "$ref": "#/$defs/artifactType" },
        "artifact_role": { "$ref": "#/$defs/artifactRole" },
        "stream_role": { "$ref": "#/$defs/streamRole" }
      }
    },
    "plannedOutputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "artifacts"],
      "properties": {
        "port": { "$ref": "#/$defs/localId" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/plannedExpectedArtifact" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "contract"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact": { "$ref": "#/$defs/localId" },
        "contract": { "$ref": "#/$defs/printableText" }
      }
    },
    "resolvedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depends_on",
        "capability_requirement",
        "capability",
        "provider_selection",
        "resolution_attempts",
        "provider_lock",
        "inputs",
        "outputs",
        "validations"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "capability_requirement": { "$ref": "#/$defs/capabilityRequirement" },
        "capability": { "$ref": "#/$defs/capability" },
        "provider_selection": { "$ref": "#/$defs/providerSelectionIntent" },
        "resolution_attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/plannedResolutionAttempt" }
        },
        "provider_lock": { "$ref": "#/$defs/providerLock" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputBinding" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/plannedOutputBinding" }
        },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation" }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_threads",
        "memory_mib",
        "storage_mib",
        "gpu_available",
        "network_available"
      ],
      "properties": {
        "cpu_threads": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "memory_mib": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "storage_mib": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "gpu_available": { "type": "boolean" },
        "network_available": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "allowed_side_effects", "offline"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "allowed_side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sideEffect" }
        },
        "offline": { "type": "boolean" }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_type",
        "artifact_role",
        "kind",
        "file_count",
        "byte_count",
        "content_sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact_type": { "$ref": "#/$defs/artifactType" },
        "artifact_role": { "$ref": "#/$defs/artifactRole" },
        "stream_role": { "$ref": "#/$defs/streamRole" },
        "kind": { "enum": ["file", "directory"] },
        "file_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "file" } } },
          "then": { "properties": { "file_count": { "const": 1 } } }
        }
      ]
    },
    "finalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "required_validations"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "artifact": { "$ref": "#/$defs/localId" },
        "required_validations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        }
      }
    },
    "planPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_schema",
        "pipeline_name",
        "configuration_sha256",
        "policy",
        "inputs",
        "stages",
        "outputs"
      ],
      "properties": {
        "pipeline_schema": { "const": "aniflow.pipeline/v3" },
        "pipeline_name": {
          "type": "string",
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "policy": { "$ref": "#/$defs/policy" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputIdentity" }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolvedStage" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finalOutput" }
        }
      }
    }
  }
}
