{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/audio-signal-measurements-v1.schema.json",
  "title": "aniflow bounded source-relative signal measurement evidence v1",
  "description": "Provider-authored PCM16 and FFmpeg ebur128 measurements with explicit unavailable values, channel scope and exact frame windows. Structural validation does not read media or replace public Rust validation of source identities, method formulas, exact commands, linear/logarithmic consistency, ordered/coalesced regions and LRA qualification. No provider-backed completion gate is added.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "technical_artifact",
    "inspection_analysis_artifact",
    "provider",
    "implementation_sha256",
    "configuration_sha256",
    "provider_lock_sha256",
    "tools",
    "settings",
    "method",
    "commands",
    "channels",
    "integrated_loudness",
    "loudness_range",
    "lra_threshold_lufs",
    "lra_qualifying_windows",
    "true_peak",
    "short_term_status",
    "short_term",
    "silence_regions",
    "clipping_regions"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-signal-measurements/v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "technical_artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "properties": {
            "id": {
              "const": "technical"
            },
            "byte_size": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "inspection_analysis_artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "properties": {
            "id": {
              "const": "analysis"
            }
          }
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "org.egohygiene.aniflow.audio-signal"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": false,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/toolObservation"
            },
            {
              "properties": {
                "id": {
                  "const": "ffmpeg"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/toolObservation"
            },
            {
              "properties": {
                "id": {
                  "const": "ffprobe"
                }
              }
            }
          ]
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "integrated_loudness": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "unit": {
              "const": "loudness_units_full_scale"
            }
          }
        },
        {
          "properties": {
            "value": {
              "properties": {
                "value": {
                  "exclusiveMinimum": -70
                }
              }
            }
          }
        }
      ]
    },
    "loudness_range": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "unit": {
              "const": "loudness_units"
            }
          }
        }
      ]
    },
    "lra_threshold_lufs": {
      "type": "number",
      "minimum": -400,
      "maximum": 24
    },
    "lra_qualifying_windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "true_peak": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "unit": {
              "const": "decibels_true_peak"
            }
          }
        }
      ]
    },
    "short_term_status": {
      "$ref": "#/$defs/seriesStatus"
    },
    "short_term": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shortTerm"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "silence_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "clipping_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "maxLength": 256,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "stream_index",
        "sample_rate_hz",
        "channels",
        "frame_count",
        "origin"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "byte_size"
          ],
          "properties": {
            "id": {
              "const": "source_audio"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 44,
              "maximum": 268435456
            }
          }
        },
        "stream_index": {
          "const": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000,
          "multipleOf": 10
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "const": 0
            },
            "denominator": {
              "const": 1
            }
          }
        },
        "stem": {
          "type": "null"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "stem_id": {
          "type": "null"
        }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 115199999
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 115200000
        }
      }
    },
    "unavailableReason": {
      "enum": [
        "silent_input",
        "insufficient_duration",
        "below_absolute_gate",
        "below_measurement_floor",
        "insufficient_gated_windows",
        "unsupported_true_peak_rate"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "measured"
            },
            "value": {
              "type": "number",
              "minimum": -400,
              "maximum": 400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/unavailableReason"
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scope",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "decibels_full_scale",
            "decibels",
            "loudness_units_full_scale",
            "loudness_units",
            "decibels_true_peak"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "decibels_full_scale"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": -400,
                    "maximum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "decibels"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": 0,
                    "maximum": 400
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "loudness_units_full_scale"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": -400,
                    "maximum": 24
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "loudness_units"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": 0,
                    "maximum": 400
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "decibels_true_peak"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "properties": {
                  "value": {
                    "minimum": -400,
                    "maximum": 24
                  }
                }
              }
            }
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "sample_peak_ratio",
        "rms_ratio",
        "sample_peak",
        "rms",
        "crest_factor"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sample_peak_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rms_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sample_peak": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels_full_scale"
                }
              }
            }
          ]
        },
        "rms": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels_full_scale"
                }
              }
            }
          ]
        },
        "crest_factor": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "decibels"
                }
              }
            }
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short_term_window_frames",
        "short_term_hop_frames",
        "integrated_minimum_frames",
        "loudness_range_minimum_frames",
        "true_peak_padding_frames",
        "loudness_range_minimum_gated_windows",
        "true_peak_max_sample_rate_hz",
        "true_peak_target_sample_rate_hz",
        "tool_summary_decimal_places",
        "short_term_decimal_places",
        "short_term_floor_lufs",
        "true_peak_sample_peak_tolerance_millidecibels"
      ],
      "properties": {
        "short_term_window_frames": {
          "type": "integer",
          "minimum": 24000,
          "maximum": 576000
        },
        "short_term_hop_frames": {
          "type": "integer",
          "minimum": 800,
          "maximum": 19200
        },
        "integrated_minimum_frames": {
          "type": "integer",
          "minimum": 3200,
          "maximum": 76800
        },
        "loudness_range_minimum_frames": {
          "type": "integer",
          "minimum": 480000,
          "maximum": 11520000
        },
        "true_peak_padding_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4800
        },
        "loudness_range_minimum_gated_windows": {
          "const": 10
        },
        "true_peak_max_sample_rate_hz": {
          "const": 48000
        },
        "true_peak_target_sample_rate_hz": {
          "const": 192000
        },
        "tool_summary_decimal_places": {
          "const": 1
        },
        "short_term_decimal_places": {
          "const": 3
        },
        "short_term_floor_lufs": {
          "const": -70
        },
        "true_peak_sample_peak_tolerance_millidecibels": {
          "const": 200
        }
      }
    },
    "seriesStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "measured"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "const": "insufficient_duration"
            }
          }
        }
      ]
    },
    "shortTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "measurement"
      ],
      "properties": {
        "range": {
          "$ref": "#/$defs/frameRange"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "unit": {
                  "const": "loudness_units_full_scale"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "measurement": {
              "properties": {
                "value": {
                  "properties": {
                    "value": {
                      "minimum": -70
                    },
                    "reason": {
                      "enum": [
                        "silent_input",
                        "below_measurement_floor"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "range"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "range": {
          "$ref": "#/$defs/frameRange"
        }
      }
    },
    "toolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "arguments"
      ],
      "properties": {
        "tool": {
          "const": "ffmpeg"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "not": {
              "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "silence_threshold_pcm",
        "minimum_silence_milliseconds",
        "clipping_threshold_pcm"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-signal.configuration/v1"
        },
        "silence_threshold_pcm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768,
          "default": 32
        },
        "minimum_silence_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 100
        },
        "clipping_threshold_pcm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "default": 32767
        }
      }
    }
  }
}
