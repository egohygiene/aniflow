{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.amv-advisory-candidate/v1",
  "$comment": "Authored/unvalidated. Current native acceptance and exact citations remain Rust checks; no model/media review or semantic grounding is established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_sha256",
    "declared_identity",
    "observed_fact_ids",
    "suggestions",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.amv-advisory-candidate/v1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "declared_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id",
        "runtime_revision",
        "profile_sha256",
        "template_sha256",
        "output_schema_sha256"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observed_fact_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "final_frame_ordinal",
                "final_pts"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "final_frame_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "final_pts": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer"
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "final_frame_ordinal",
                "final_pts"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "final_frame_ordinal": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "final_pts": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer"
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
