{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.toolchain-workflow-bundle/v1",
  "$comment": "Authored/unvalidated. Private inert configuration bytes; no installation/provider/native authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_sha256",
    "preparation_sha256",
    "files",
    "selected_roles",
    "omitted_roles",
    "tools_or_models_copied",
    "provider_registration_performed",
    "native_qualified",
    "execution_authority",
    "publication_authority"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.toolchain-workflow-bundle/v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preparation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(setup-(request|preparation)[.]json|[a-z_]+/configuration[.]json)$",
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          }
        }
      }
    },
    "selected_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frame_extraction",
          "image_repair",
          "upscale",
          "interpolation",
          "clean_video_assembly",
          "caption_rendering",
          "metadata_remux",
          "destination_video",
          "lossless_audio_export",
          "final_video_audio_qc",
          "final_lossless_audio_qc"
        ]
      }
    },
    "omitted_roles": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frame_extraction",
          "image_repair",
          "upscale",
          "interpolation",
          "clean_video_assembly",
          "caption_rendering",
          "metadata_remux",
          "destination_video",
          "lossless_audio_export",
          "final_video_audio_qc",
          "final_lossless_audio_qc"
        ]
      }
    },
    "tools_or_models_copied": {
      "const": false
    },
    "provider_registration_performed": {
      "const": false
    },
    "native_qualified": {
      "const": false
    },
    "execution_authority": {
      "const": "none; local configuration package only"
    },
    "publication_authority": {
      "const": "none"
    }
  }
}
