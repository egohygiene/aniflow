{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/egohygiene/aniflow/docs/contracts/toolchain-publishing-setup-v1.schema.json",
  "title": "toolchain-publishing-setup-v1",
  "required": [
    "schema",
    "profile",
    "inventory",
    "selections"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.toolchain.publishing-setup/v1"
    },
    "profile": {
      "$ref": "toolchain-profile-v1.schema.json"
    },
    "inventory": {
      "$ref": "toolchain-inventory-v1.schema.json"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "selection"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "selection": {
            "allOf": [
              {
                "$ref": "toolchain-media-setup-v1.schema.json#/properties/selection"
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "destination_video",
                      "caption_rendering",
                      "final_video_audio_qc",
                      "metadata_remux",
                      "lossless_audio_export"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$comment": "One MiB request. Exact distinct capability IDs, dependencies, closed effective settings and side effects are validated by the existing typed mapping. No inferred selections, source media or execution."
}
