{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-midi.configuration/v1",
  "title": "audio MIDI candidate settings v1",
  "description": "Closed bounded MIDI candidate contract. Rust additionally checks exact identities, canonical source timing, note order and overlap, source-relative bounds, deterministic note/tick derivation and MIDI bytes. Candidate activation is not calibrated confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "python",
    "adapter",
    "runtime",
    "model",
    "tool_timeout_milliseconds",
    "maximum_tool_output_bytes"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-midi.configuration/v1"
    },
    "python": {
      "$ref": "#/$defs/pythonPin"
    },
    "adapter": {
      "$ref": "#/$defs/adapterPin"
    },
    "runtime": {
      "$ref": "#/$defs/runtimePin"
    },
    "model": {
      "$ref": "#/$defs/modelPin"
    },
    "tool_timeout_milliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "maximum_tool_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 2097152
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ],
      "maxLength": 4096
    },
    "adapterPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "modelPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "model_id",
        "revision"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "const": 230444
        },
        "model_id": {
          "const": "basic-pitch-onnx-icassp-2022"
        },
        "revision": {
          "const": "9991303bba609a3b93089d13ec80d1d495083596"
        }
      }
    },
    "pythonPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "version": {
          "type": "string",
          "pattern": "^3\\.(?:10|11)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "file_count",
        "byte_count"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  }
}
