{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-inspection.configuration/v1",
  "title": "aniflow bounded local audio inspection configuration v1",
  "description": "Exact executable identity pins for already installed FFmpeg and ffprobe. No download, PATH discovery, source replacement or model inference is authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ffmpeg",
    "ffprobe",
    "tool_timeout_milliseconds",
    "maximum_tool_output_bytes"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-inspection.configuration/v1"
    },
    "ffmpeg": {
      "$ref": "#/$defs/toolPin"
    },
    "ffprobe": {
      "$ref": "#/$defs/toolPin"
    },
    "tool_timeout_milliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "maximum_tool_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ]
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "toolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
