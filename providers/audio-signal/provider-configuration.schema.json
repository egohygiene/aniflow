{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-signal.provider-configuration/v1",
  "title": "aniflow source-bound signal provider configuration v1",
  "description": "The typed facade materializes signal defaults and binds immutable source identity, exact executable identities and tool bounds into the existing provider lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settings",
    "tools",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-signal.provider-configuration/v1"
    },
    "settings": {
      "$ref": "#/$defs/signalSettings"
    },
    "tools": {
      "$ref": "#/$defs/inspectionSettings"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "source_audio"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 44,
          "maximum": 268435456
        }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ]
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "toolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signalSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "silence_threshold_pcm",
        "minimum_silence_milliseconds",
        "clipping_threshold_pcm"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-signal.configuration/v1"
        },
        "silence_threshold_pcm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768,
          "default": 32
        },
        "minimum_silence_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 100
        },
        "clipping_threshold_pcm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "default": 32767
        }
      }
    },
    "inspectionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ffmpeg",
        "ffprobe",
        "tool_timeout_milliseconds",
        "maximum_tool_output_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-inspection.configuration/v1"
        },
        "ffmpeg": {
          "$ref": "#/$defs/toolPin"
        },
        "ffprobe": {
          "$ref": "#/$defs/toolPin"
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    }
  }
}
