{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.allenk-frame-repair-provider-configuration/v1",
  "title": "aniflow named allenk frame repair provider configuration v1",
  "description": "Complete effective settings and sorted manual ranges for the distinct aniflow/frame-repair-allenk capability. Every nested definition is local so the provider schema digest covers the closed configuration. Runtime additionally binds the exact same-run importer, actual installed executable/decoder identities and complete source mapping. A generic profile string or loose import report cannot grant named-provider resume authority. This schema does not establish native qualification or complete host dependency identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settings",
    "ranges"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.allenk-frame-repair-provider-configuration/v1"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
              }
            }
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ffmpeg",
        "tool_timeout_milliseconds",
        "maximum_source_bytes",
        "maximum_frame_bytes",
        "maximum_total_frame_bytes",
        "maximum_pixels"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.frame-import-configuration/v1"
        },
        "ffmpeg": {
          "$ref": "#/$defs/tool"
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "maximum_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "maximum_total_frame_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8400000
        }
      }
    },
    "allenk_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
              }
            }
          ]
        },
        "version": {
          "const": "0.3.2"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "watermark_profile": {
      "type": "string",
      "enum": [
        "current_v2",
        "legacy_v1"
      ],
      "description": "Explicit visible-overlay family. Current V2 disables legacy fallback; legacy V1 skips the current-profile attempt. No automatic profile selection."
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "import",
        "tool",
        "watermark_profile",
        "detection_threshold_percent",
        "maximum_working_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.allenk-frame-repair-configuration/v1"
        },
        "import": {
          "$ref": "#/$defs/import"
        },
        "tool": {
          "$ref": "#/$defs/allenk_tool"
        },
        "watermark_profile": {
          "$ref": "#/$defs/watermark_profile"
        },
        "detection_threshold_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 25,
          "description": "Detection confidence threshold in whole percent; Rust generates a fixed decimal argv value such as 25 -> 0.25. This does not grant automatic edit selection or certify a detected overlay."
        },
        "maximum_working_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 17592186044416,
          "default": 274877906944,
          "description": "Aggregate working-data admission, not a filesystem reservation or process memory quota. Independent outer provider limits still apply."
        }
      }
    }
  }
}
