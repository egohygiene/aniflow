{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.audio-transcription.provider-configuration/v1",
  "title": "source-bound transcription provider configuration v1",
  "description": "Closed bounded transcription profile. Rust additionally validates UTF-8 byte limits, reduced timing, source duration, stable segment order, exact command/settings identities, and derived timed-text equality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settings",
    "tools",
    "source",
    "upstream_analysis_artifact_id"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.audio-transcription.provider-configuration/v1"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "tools": {
      "$ref": "#/$defs/inspectionSettings"
    },
    "source": {
      "$ref": "#/$defs/sourcePin"
    },
    "upstream_analysis_artifact_id": {
      "enum": [
        "analysis",
        "stem_analysis"
      ]
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ],
      "maxLength": 4096
    },
    "inspectionAbsolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        }
      ]
    },
    "inspectionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ffmpeg",
        "ffprobe",
        "tool_timeout_milliseconds",
        "maximum_tool_output_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-inspection.configuration/v1"
        },
        "ffmpeg": {
          "$ref": "#/$defs/inspectionToolPin"
        },
        "ffprobe": {
          "$ref": "#/$defs/inspectionToolPin"
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "inspectionToolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/inspectionAbsolutePath"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "modelPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "model_id",
        "revision"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "model_id": {
          "const": "tiny.en"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        }
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "maxLength": 256
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "whisper",
        "model",
        "language",
        "threads",
        "tool_timeout_milliseconds",
        "maximum_tool_output_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.audio-transcription.configuration/v1"
        },
        "whisper": {
          "$ref": "#/$defs/whisperPin"
        },
        "model": {
          "$ref": "#/$defs/modelPin"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-z-]+(?![\\s\\S])"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "tool_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maximum_tool_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "sourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "source_audio"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    },
    "whisperPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/absolutePath"
        },
        "version": {
          "const": "1.8.7"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
