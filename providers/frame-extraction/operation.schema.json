{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniflow.frame-extraction-operation/v1",
  "title": "aniflow frozen source frame extraction operation v1",
  "description": "Materialized settings and current source-byte identity bound into the existing Pipeline v3 provider lock. Geometry, count and native temporal/color evidence remain pending until the source is observed during execution. Local nested definitions bind the complete configuration schema digest; this document grants no execution or reuse authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "settings",
    "source_sha256",
    "source_byte_count"
  ],
  "properties": {
    "schema": {
      "const": "aniflow.frame-extraction-operation/v1"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_byte_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            {
              "not": {
                "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
              }
            }
          ]
        },
        "version": {
          "const": "8.0.1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_stream",
        "audio_stream",
        "no_audio",
        "discard_streams"
      ],
      "properties": {
        "video_stream": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "audio_stream": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "no_audio": {
          "type": "boolean"
        },
        "discard_streams": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "maxItems": 4096
        }
      },
      "oneOf": [
        {
          "properties": {
            "no_audio": {
              "const": true
            },
            "audio_stream": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "audio_stream"
          ],
          "properties": {
            "no_audio": {
              "const": false
            },
            "audio_stream": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ffmpeg",
        "ffprobe",
        "source_selection",
        "timeout_milliseconds",
        "maximum_capture_bytes",
        "maximum_source_bytes",
        "maximum_frame_bytes",
        "maximum_total_frame_bytes",
        "maximum_pixels",
        "maximum_frames",
        "maximum_working_bytes",
        "minimum_free_bytes"
      ],
      "properties": {
        "schema": {
          "const": "aniflow.frame-extraction-configuration/v1"
        },
        "ffmpeg": {
          "$ref": "#/$defs/tool"
        },
        "ffprobe": {
          "$ref": "#/$defs/tool"
        },
        "source_selection": {
          "$ref": "#/$defs/selection"
        },
        "timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600000
        },
        "maximum_capture_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 67108864
        },
        "maximum_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "maximum_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "maximum_total_frame_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "maximum_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "maximum_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maximum_working_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 17592186044416
        },
        "minimum_free_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      }
    }
  }
}
